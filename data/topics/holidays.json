  "sentences": [
    {
      "en": "Happy New Year!",
      "zh": "新年快樂！",
      "note": "新年時互相祝福"
    },
    {
      "en": "Wishing you good health and happiness.",
      "zh": "祝你健康又快樂。",
      "note": "寫賀卡或祝福時"
    },
    {
      "en": "What do you usually do on holidays?",
      "zh": "你放假時通常做什麼？",
      "note": "詢問假日安排時"
    },
    {
      "en": "We get together with our relatives.",
      "zh": "我們與親戚團聚。",
      "note": "說明過節習慣時"
    },
    {
      "en": "I got a red envelope from my grandma.",
      "zh": "奶奶給了我紅包。",
      "note": "談論新年收穫時"
    },
    {
      "en": "The Dragon Boat Festival is in the fifth lunar month.",
      "zh": "端午節在農曆五月。",
      "note": "介紹節日日期時"
    },
    {
      "en": "We eat rice dumplings on that day.",
      "zh": "那一天我們吃粽子。",
      "note": "介紹節慶食物時"
    },
    {
      "en": "Let's have a barbecue for the Moon Festival.",
      "zh": "我們中秋節來烤肉吧。",
      "note": "邀約過中秋時"
    },
    {
      "en": "Merry Christmas! This gift is for you.",
      "zh": "聖誕快樂！這份禮物送給你。",
      "note": "送聖誕禮物時"
    },
    {
      "en": "Trick or treat!",
      "zh": "不給糖就搗蛋！",
      "note": "萬聖節討糖果時"
    },
    {
      "en": "Happy birthday! Make a wish.",
      "zh": "生日快樂！許個願吧。",
      "note": "慶祝生日時"
    },
    {
      "en": "Thank you for the lovely card.",
      "zh": "謝謝你寄來的可愛卡片。",
      "note": "收到賀卡時"
    },
    {
      "en": "Are you going to watch the fireworks?",
      "zh": "你要去看煙火嗎？",
      "note": "詢問節慶活動時"
    },
    {
      "en": "Which holiday do you like best?",
      "zh": "你最喜歡哪個節日？",
      "note": "聊節日話題時"
    },
    {
      "en": "Have a wonderful holiday!",
      "zh": "祝你假期愉快！",
      "note": "放假前道別時"
    }
  ],
  "dialogues": [
    {
      "title": "談新年",
      "lines": [
        {
          "who": "A",
          "en": "Happy New Year, Grandma!",
          "zh": "奶奶，新年快樂！"
        },
        {
          "who": "B",
          "en": "Happy New Year! Here's a red envelope for you.",
          "zh": "新年快樂！這個紅包給你。"
        },
        {
          "who": "A",
          "en": "Thank you. I wish you good health.",
          "zh": "謝謝，祝您身體健康。"
        },
        {
          "who": "B",
          "en": "You're a good child. Let's eat dumplings.",
          "zh": "你真乖，我們來吃餃子吧。"
        },
        {
          "who": "A",
          "en": "Great! I'm hungry.",
          "zh": "太棒了，我肚子餓了。"
        }
      ]
    },
    {
      "title": "中秋節計畫",
      "lines": [
        {
          "who": "A",
          "en": "Are you free on the Moon Festival?",
          "zh": "你中秋節有空嗎？"
        },
        {
          "who": "B",
          "en": "Yes. We'll have a barbecue in the park.",
          "zh": "有，我們要在公園烤肉。"
        },
        {
          "who": "A",
          "en": "That sounds good. Can I bring pomelos?",
          "zh": "聽起來不錯，我可以帶文旦嗎？"
        },
        {
          "who": "B",
          "en": "Of course! We also have mooncakes.",
          "zh": "當然！我們也有月餅。"
        }
      ]
    }
  ],
