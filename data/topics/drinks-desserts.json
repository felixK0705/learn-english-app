  "sentences": [
    {
      "en": "I would like a large bubble tea.",
      "zh": "我要一杯大杯珍珠奶茶。",
      "note": "點飲料時"
    },
    {
      "en": "Can I have less sugar and no ice?",
      "zh": "可以少糖去冰嗎？",
      "note": "客製甜度冰塊時"
    },
    {
      "en": "What size do you want?",
      "zh": "你要什麼尺寸？",
      "note": "店員詢問時"
    },
    {
      "en": "Is it hot or iced?",
      "zh": "是熱的還是冰的？",
      "note": "選擇溫度時"
    },
    {
      "en": "Could I have a straw, please?",
      "zh": "可以給我一支吸管嗎？",
      "note": "需要吸管時"
    },
    {
      "en": "What do you recommend?",
      "zh": "你推薦什麼？",
      "note": "不知道喝什麼時"
    },
    {
      "en": "I will have the same.",
      "zh": "我也要一樣的。",
      "note": "跟朋友點同樣的東西"
    },
    {
      "en": "Can I add pearls to this?",
      "zh": "這個可以加珍珠嗎？",
      "note": "加料時"
    },
    {
      "en": "Do you have any sugar-free drinks?",
      "zh": "你們有無糖的飲料嗎？",
      "note": "想少吃糖時"
    },
    {
      "en": "This cake looks delicious.",
      "zh": "這個蛋糕看起來好好吃。",
      "note": "在甜點店看櫥窗時"
    },
    {
      "en": "Can I get a slice of chocolate cake?",
      "zh": "我可以點一片巧克力蛋糕嗎？",
      "note": "點甜點時"
    },
    {
      "en": "Let us share a dessert.",
      "zh": "我們一起分一份甜點吧。",
      "note": "邀請朋友共享時"
    },
    {
      "en": "Could you put it in a cup holder?",
      "zh": "可以幫我放進杯架嗎？",
      "note": "外帶多杯飲料時"
    },
    {
      "en": "Your drink will be ready in five minutes.",
      "zh": "你的飲料五分鐘後好。",
      "note": "店員說明等待時間"
    }
  ],
  "dialogues": [
    {
      "title": "在手搖飲料店",
      "lines": [
        {
          "who": "A",
          "en": "Hi! One milk tea, large, please.",
          "zh": "嗨！一杯大杯奶茶。"
        },
        {
          "who": "B",
          "en": "Hot or iced? How about the sugar?",
          "zh": "要熱的還是冰的？甜度呢？"
        },
        {
          "who": "A",
          "en": "Iced, with less sugar and extra pearls.",
          "zh": "冰的，少糖，加珍珠。"
        },
        {
          "who": "B",
          "en": "Sure. That will be sixty-five dollars.",
          "zh": "好的，一共六十五元。"
        }
      ]
    },
    {
      "title": "在甜點店",
      "lines": [
        {
          "who": "A",
          "en": "Everything looks so good. What do you recommend?",
          "zh": "每樣看起來都好好吃，你推薦什麼？"
        },
        {
          "who": "B",
          "en": "The mango cake is very popular.",
          "zh": "芒果蛋糕很受歡迎。"
        },
        {
          "who": "A",
          "en": "Great. I will have a slice, and a cup of tea.",
          "zh": "太好了，我要一片，再加一杯茶。"
        },
        {
          "who": "B",
          "en": "Please take a seat. I will bring it to you.",
          "zh": "請入座，我送到你的位子上。"
        }
      ]
    }
  ]
}
