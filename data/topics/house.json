  "sentences": [
    {
      "en": "Welcome to my home.",
      "zh": "歡迎來我家。",
      "note": "客人到訪時"
    },
    {
      "en": "Come on in and make yourself at home.",
      "zh": "請進，別客氣，當自己家。",
      "note": "招呼客人進門時"
    },
    {
      "en": "Where's the bathroom?",
      "zh": "請問洗手間在哪裡？",
      "note": "到別人家詢問時"
    },
    {
      "en": "Please take off your shoes at the door.",
      "zh": "請在門口脫鞋。",
      "note": "請客人脫鞋時"
    },
    {
      "en": "I live in an apartment on the third floor.",
      "zh": "我住在三樓的公寓。",
      "note": "介紹自己住的地方時"
    },
    {
      "en": "Our house has two floors and a small yard.",
      "zh": "我們家有兩層樓和一個小院子。",
      "note": "描述房子時"
    },
    {
      "en": "Who is it?",
      "zh": "請問是哪位？",
      "note": "有人按門鈴或敲門時"
    },
    {
      "en": "Could you hold the door for me?",
      "zh": "可以幫我扶一下門嗎？",
      "note": "雙手拿東西進出時"
    },
    {
      "en": "I forgot my key. I'm locked out.",
      "zh": "我忘了帶鑰匙，被鎖在外面了。",
      "note": "進不了家門時"
    },
    {
      "en": "How much is the rent per month?",
      "zh": "每個月的房租是多少？",
      "note": "租房子詢問價格時"
    },
    {
      "en": "When can I move in?",
      "zh": "我什麼時候可以搬進來？",
      "note": "與房東討論入住時間時"
    },
    {
      "en": "The elevator is out of order.",
      "zh": "電梯故障了。",
      "note": "電梯壞掉時"
    },
    {
      "en": "Which floor are you going to?",
      "zh": "你要去幾樓？",
      "note": "在電梯裡詢問別人時"
    },
    {
      "en": "Our neighbors are very quiet.",
      "zh": "我們的鄰居都很安靜。",
      "note": "談論居住環境時"
    }
  ],
  "dialogues": [
    {
      "title": "新朋友來家裡",
      "lines": [
        {
          "who": "A",
          "en": "Hi, Amy! Come on in.",
          "zh": "嗨，艾咪！快進來。"
        },
        {
          "who": "B",
          "en": "Thanks, Tom. Your house is so nice!",
          "zh": "謝謝你，湯姆。你家好漂亮！"
        },
        {
          "who": "A",
          "en": "Please take off your shoes at the door.",
          "zh": "請在門口脫鞋。"
        },
        {
          "who": "B",
          "en": "Sure. Where should I put my bag?",
          "zh": "好的。我的包包要放哪裡？"
        },
        {
          "who": "A",
          "en": "Put it in the hallway.",
          "zh": "放在玄關就好。"
        }
      ]
    },
    {
      "title": "找房子",
      "lines": [
        {
          "who": "A",
          "en": "Hello, I'm looking for an apartment.",
          "zh": "你好，我在找公寓。"
        },
        {
          "who": "B",
          "en": "We have one on the fifth floor.",
          "zh": "我們有一間在五樓。"
        },
        {
          "who": "A",
          "en": "Does it have a balcony?",
          "zh": "它有陽台嗎？"
        },
        {
          "who": "B",
          "en": "Yes, and the rent isn't expensive.",
          "zh": "有，而且房租不貴。"
        },
        {
          "who": "A",
          "en": "Great. Can I see it today?",
          "zh": "太好了。我今天可以看房嗎？"
        }
      ]
    }
  ],
