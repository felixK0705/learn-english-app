  "sentences": [
    {
      "en": "Do you have any pets?",
      "zh": "你有養寵物嗎？",
      "note": "聊天問對方是否養寵物"
    },
    {
      "en": "I have a dog named Lucky.",
      "zh": "我有一隻叫 Lucky 的狗。",
      "note": "介紹自己的寵物"
    },
    {
      "en": "What's your cat's name?",
      "zh": "你的貓叫什麼名字？",
      "note": "詢問寵物名字"
    },
    {
      "en": "Can I pet your dog?",
      "zh": "我可以摸你的狗嗎？",
      "note": "摸別人的狗之前先詢問"
    },
    {
      "en": "Does he bite?",
      "zh": "牠會咬人嗎？",
      "note": "詢問狗是否友善"
    },
    {
      "en": "Don't worry, she is very gentle.",
      "zh": "別擔心，牠很溫馴。",
      "note": "安撫對方"
    },
    {
      "en": "I need to take my dog to the vet.",
      "zh": "我得帶狗去看獸醫。",
      "note": "說明帶寵物看病"
    },
    {
      "en": "It's time to feed the chickens.",
      "zh": "該餵雞了。",
      "note": "農場日常工作"
    },
    {
      "en": "How often do you walk your dog?",
      "zh": "你多久遛一次狗？",
      "note": "聊照顧寵物的習慣"
    },
    {
      "en": "My cat is afraid of loud noises.",
      "zh": "我的貓怕大聲響。",
      "note": "描述寵物個性"
    },
    {
      "en": "Please keep your dog on a leash.",
      "zh": "請把你的狗牽好。",
      "note": "公園提醒飼主"
    },
    {
      "en": "Cows give us milk.",
      "zh": "乳牛提供我們牛奶。",
      "note": "說明農場動物的用途"
    },
    {
      "en": "The farm is full of animals.",
      "zh": "這座農場裡有好多動物。",
      "note": "描述農場"
    },
    {
      "en": "I want to adopt a puppy.",
      "zh": "我想領養一隻小狗。",
      "note": "表達想養寵物"
    },
    {
      "en": "Who is going to clean the cage?",
      "zh": "誰要來清理籠子？",
      "note": "分配家裡照顧寵物的工作"
    }
  ],
  "dialogues": [
    {
      "title": "聊寵物",
      "lines": [
        {
          "who": "A",
          "en": "Do you have any pets?",
          "zh": "你有養寵物嗎？"
        },
        {
          "who": "B",
          "en": "Yes, I have a cat and a hamster.",
          "zh": "有，我有一隻貓和一隻倉鼠。"
        },
        {
          "who": "A",
          "en": "What are their names?",
          "zh": "牠們叫什麼名字？"
        },
        {
          "who": "B",
          "en": "The cat is Mimi and the hamster is Nuts.",
          "zh": "貓叫 Mimi，倉鼠叫 Nuts。"
        },
        {
          "who": "A",
          "en": "They sound adorable!",
          "zh": "聽起來好可愛！"
        }
      ]
    },
    {
      "title": "參觀農場",
      "lines": [
        {
          "who": "A",
          "en": "Look at all the animals on this farm!",
          "zh": "看看這座農場有這麼多動物！"
        },
        {
          "who": "B",
          "en": "Can we feed the goats?",
          "zh": "我們可以餵山羊嗎？"
        },
        {
          "who": "A",
          "en": "Yes, but be gentle with them.",
          "zh": "可以，但要對牠們溫柔一點。"
        },
        {
          "who": "B",
          "en": "Oh, this one is eating my sleeve!",
          "zh": "噢，這隻在啃我的袖子！"
        }
      ]
    }
  ]
}
