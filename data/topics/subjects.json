  "sentences": [
    {
      "en": "What is your favorite subject?",
      "zh": "你最喜歡的科目是什麼？",
      "note": "聊學校生活時"
    },
    {
      "en": "I'm good at math, but not so good at English.",
      "zh": "我數學很好，但英文沒那麼好。",
      "note": "談自己的強項與弱項"
    },
    {
      "en": "What time does the first class start?",
      "zh": "第一堂課幾點開始？",
      "note": "詢問課程時間"
    },
    {
      "en": "Do we have homework today?",
      "zh": "我們今天有作業嗎？",
      "note": "放學前確認作業"
    },
    {
      "en": "When is the next test?",
      "zh": "下一次考試是什麼時候？",
      "note": "詢問考試時間"
    },
    {
      "en": "I got a hundred on the quiz!",
      "zh": "我小考得了一百分！",
      "note": "分享好成績"
    },
    {
      "en": "Let's study together after school.",
      "zh": "我們放學後一起讀書吧。",
      "note": "邀請同學一起複習"
    },
    {
      "en": "Which club are you in?",
      "zh": "你參加哪個社團？",
      "note": "認識新朋友時"
    },
    {
      "en": "Where is the library?",
      "zh": "圖書館在哪裡？",
      "note": "新生問路時"
    },
    {
      "en": "Lunch break is from twelve to one.",
      "zh": "午休時間是十二點到一點。",
      "note": "說明作息時間"
    },
    {
      "en": "I have P.E. on Tuesday and Thursday.",
      "zh": "我星期二和星期四有體育課。",
      "note": "談論課表"
    },
    {
      "en": "Can I see your class schedule?",
      "zh": "我可以看你的課表嗎？",
      "note": "和同學比較課表"
    },
    {
      "en": "I'm nervous about the exam.",
      "zh": "我對這次考試感到緊張。",
      "note": "表達考前心情"
    },
    {
      "en": "Our school trip is next Friday.",
      "zh": "我們的校外教學在下週五。",
      "note": "宣布活動時"
    }
  ],
  "dialogues": [
    {
      "title": "聊聊課表",
      "lines": [
        {
          "who": "A",
          "en": "What do you have after recess?",
          "zh": "下課後你有什麼課？"
        },
        {
          "who": "B",
          "en": "I have English and then art.",
          "zh": "我有英文，接著是美術。"
        },
        {
          "who": "A",
          "en": "I like art class the most.",
          "zh": "我最喜歡美術課。"
        },
        {
          "who": "B",
          "en": "Me too. We can sit together.",
          "zh": "我也是，我們可以坐在一起。"
        }
      ]
    },
    {
      "title": "考試前",
      "lines": [
        {
          "who": "A",
          "en": "Are you ready for the science test?",
          "zh": "你準備好自然科考試了嗎？"
        },
        {
          "who": "B",
          "en": "Not really. I only studied for an hour.",
          "zh": "還沒，我只讀了一個小時。"
        },
        {
          "who": "A",
          "en": "Let's review in the library at lunch.",
          "zh": "我們午餐時間到圖書館複習吧。"
        },
        {
          "who": "B",
          "en": "Great idea. Thank you!",
          "zh": "好主意，謝謝你！"
        }
      ]
    }
  ],
