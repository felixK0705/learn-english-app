  "sentences": [
    {
      "en": "Could you turn on the air conditioner?",
      "zh": "可以請你開冷氣嗎？",
      "note": "覺得熱時"
    },
    {
      "en": "It's too cold. Please turn it off.",
      "zh": "太冷了，請把它關掉。",
      "note": "覺得冷氣太強時"
    },
    {
      "en": "Where's the remote for the fan?",
      "zh": "電風扇的遙控器在哪裡？",
      "note": "找不到遙控器時"
    },
    {
      "en": "The washing machine isn't working.",
      "zh": "洗衣機壞了。",
      "note": "電器故障時"
    },
    {
      "en": "This printer is out of order.",
      "zh": "這台印表機故障了。",
      "note": "電器故障時"
    },
    {
      "en": "How do I turn this on?",
      "zh": "這個要怎麼開？",
      "note": "不會使用電器時"
    },
    {
      "en": "Can I use your charger?",
      "zh": "我可以用你的充電器嗎？",
      "note": "手機沒電時"
    },
    {
      "en": "My laptop is out of battery.",
      "zh": "我的筆電沒電了。",
      "note": "需要充電時"
    },
    {
      "en": "Is there an outlet nearby?",
      "zh": "附近有插座嗎？",
      "note": "找插座時"
    },
    {
      "en": "Please unplug it before you clean it.",
      "zh": "清潔前請先拔掉插頭。",
      "note": "提醒用電安全時"
    },
    {
      "en": "Turn down the TV. I'm studying.",
      "zh": "電視小聲一點，我在念書。",
      "note": "需要安靜時"
    },
    {
      "en": "The microwave is beeping.",
      "zh": "微波爐在嗶嗶響。",
      "note": "食物加熱好時"
    },
    {
      "en": "Don't leave the heater on at night.",
      "zh": "晚上不要一直開著暖氣機。",
      "note": "提醒用電安全時"
    },
    {
      "en": "Let me know when the dryer is done.",
      "zh": "烘乾機好了請告訴我。",
      "note": "請人留意時"
    }
  ],
  "dialogues": [
    {
      "title": "冷氣太冷",
      "lines": [
        {
          "who": "A",
          "en": "It's so hot in here.",
          "zh": "這裡好熱。"
        },
        {
          "who": "B",
          "en": "Let me turn on the air conditioner.",
          "zh": "我來開冷氣。"
        },
        {
          "who": "A",
          "en": "Thanks. Where's the remote?",
          "zh": "謝謝。遙控器在哪裡？"
        },
        {
          "who": "B",
          "en": "It's on the shelf. Set it to twenty-six degrees.",
          "zh": "在架子上。設定二十六度。"
        },
        {
          "who": "A",
          "en": "Okay. Oh, now it's a little cold.",
          "zh": "好。喔，現在有點冷了。"
        }
      ]
    },
    {
      "title": "手機沒電",
      "lines": [
        {
          "who": "A",
          "en": "My phone ran out of battery.",
          "zh": "我的手機沒電了。"
        },
        {
          "who": "B",
          "en": "You can use my charger.",
          "zh": "你可以用我的充電器。"
        },
        {
          "who": "A",
          "en": "Great. Is there an outlet nearby?",
          "zh": "太好了。附近有插座嗎？"
        },
        {
          "who": "B",
          "en": "Yes, next to the TV.",
          "zh": "有，在電視旁邊。"
        }
      ]
    }
  ],
