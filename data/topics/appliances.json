  "dialogues": [
    {
      "title": "冷氣太冷",
      "lines": [
        {
          "who": "A",
          "en": "It is so hot in here.",
          "zh": "這裡好熱。"
        },
        {
          "who": "B",
          "en": "Let me turn on the air conditioner.",
          "zh": "我來開冷氣。"
        },
        {
          "who": "A",
          "en": "Thanks. Where is the remote?",
          "zh": "謝謝。遙控器在哪裡？"
        },
        {
          "who": "B",
          "en": "It is on the shelf. Set it to twenty-six degrees.",
          "zh": "在架子上。設定二十六度。"
        },
        {
          "who": "A",
          "en": "Okay. Oh, now it is a little cold.",
          "zh": "好。喔，現在有點冷了。"
        }
      ]
    },
    {
      "title": "手機沒電",
      "lines": [
        {
          "who": "A",
          "en": "My phone ran out of battery.",
          "zh": "我的手機沒電了。"
        },
        {
          "who": "B",
          "en": "You can use my charger.",
          "zh": "你可以用我的充電器。"
        },
        {
          "who": "A",
          "en": "Great. Is there an outlet nearby?",
          "zh": "太好了。附近有插座嗎？"
        },
        {
          "who": "B",
          "en": "Yes, next to the TV.",
          "zh": "有，在電視旁邊。"
        }
      ]
    }
  ]
