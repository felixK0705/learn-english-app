  "sentences": [
    {
      "en": "I would like a pound of ground pork.",
      "zh": "我要一磅豬絞肉。",
      "note": "向肉販買肉時"
    },
    {
      "en": "Is this fish fresh?",
      "zh": "這條魚新鮮嗎？",
      "note": "挑魚時"
    },
    {
      "en": "Could you cut it into pieces?",
      "zh": "可以幫我切塊嗎？",
      "note": "請肉販處理時"
    },
    {
      "en": "Can you clean the shrimp for me?",
      "zh": "可以幫我處理蝦子嗎？",
      "note": "請魚販代為清理時"
    },
    {
      "en": "How much is a kilo of salmon?",
      "zh": "鮭魚一公斤多少錢？",
      "note": "詢問價格時"
    },
    {
      "en": "What is the best cut for a stew?",
      "zh": "什麼部位最適合燉湯？",
      "note": "詢問肉的部位時"
    },
    {
      "en": "I would like the chicken without the skin.",
      "zh": "我要不帶皮的雞肉。",
      "note": "指定處理方式時"
    },
    {
      "en": "Please remove the bones.",
      "zh": "請幫我去骨。",
      "note": "不想吃到骨頭時"
    },
    {
      "en": "I am allergic to shellfish.",
      "zh": "我對甲殼類海鮮過敏。",
      "note": "說明過敏時"
    },
    {
      "en": "How would you like your steak?",
      "zh": "你的牛排要幾分熟？",
      "note": "餐廳詢問熟度時"
    },
    {
      "en": "This meat has a lot of fat.",
      "zh": "這塊肉的肥肉很多。",
      "note": "挑肉時"
    },
    {
      "en": "Do you have any fresh crab today?",
      "zh": "你們今天有新鮮的螃蟹嗎？",
      "note": "在海鮮店詢問時"
    },
    {
      "en": "Please wrap it separately.",
      "zh": "請分開包裝。",
      "note": "需要分袋時"
    },
    {
      "en": "I do not eat pork.",
      "zh": "我不吃豬肉。",
      "note": "說明飲食禁忌時"
    }
  ],
  "dialogues": [
    {
      "title": "在傳統市場買肉",
      "lines": [
        {
          "who": "A",
          "en": "Good morning. I need some pork ribs.",
          "zh": "早安，我要一些豬排骨。"
        },
        {
          "who": "B",
          "en": "How many do you want?",
          "zh": "你要多少？"
        },
        {
          "who": "A",
          "en": "About one kilo. Please cut them up.",
          "zh": "大約一公斤，請幫我切塊。"
        },
        {
          "who": "B",
          "en": "No problem. Anything else?",
          "zh": "沒問題，還要別的嗎？"
        },
        {
          "who": "A",
          "en": "Two pounds of ground beef too.",
          "zh": "再給我兩磅牛絞肉。"
        }
      ]
    },
    {
      "title": "在海鮮店",
      "lines": [
        {
          "who": "A",
          "en": "Are these shrimp fresh?",
          "zh": "這些蝦子新鮮嗎？"
        },
        {
          "who": "B",
          "en": "Yes. They just came in this morning.",
          "zh": "是的，今早才送到。"
        },
        {
          "who": "A",
          "en": "Then I will take half a kilo.",
          "zh": "那我要半公斤。"
        },
        {
          "who": "B",
          "en": "Do you want me to clean them?",
          "zh": "要幫你處理嗎？"
        }
      ]
    }
  ]
}
