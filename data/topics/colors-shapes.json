  "sentences": [
    {
      "en": "What color is it?",
      "zh": "它是什麼顏色？",
      "note": "詢問顏色"
    },
    {
      "en": "What is your favorite color?",
      "zh": "你最喜歡什麼顏色？",
      "note": "聊喜好時"
    },
    {
      "en": "It is bright red.",
      "zh": "它是鮮紅色的。",
      "note": "描述顏色"
    },
    {
      "en": "What shape is this?",
      "zh": "這是什麼形狀？",
      "note": "詢問形狀"
    },
    {
      "en": "It looks like a circle.",
      "zh": "它看起來像個圓形。",
      "note": "描述形狀"
    },
    {
      "en": "Can you pass me the blue crayon?",
      "zh": "你可以把藍色蠟筆遞給我嗎？",
      "note": "美勞課借東西"
    },
    {
      "en": "Let us mix yellow and blue.",
      "zh": "我們把黃色和藍色混在一起吧。",
      "note": "做顏料實驗"
    },
    {
      "en": "Color the star yellow.",
      "zh": "把星星塗成黃色。",
      "note": "老師指示作業時"
    },
    {
      "en": "Draw a big triangle in the middle.",
      "zh": "在中間畫一個大三角形。",
      "note": "美術指令"
    },
    {
      "en": "How many sides does a square have?",
      "zh": "正方形有幾個邊？",
      "note": "數學課提問"
    },
    {
      "en": "The sun is round and bright.",
      "zh": "太陽又圓又亮。",
      "note": "描述事物"
    },
    {
      "en": "I like your pink shirt.",
      "zh": "我喜歡你的粉紅色襯衫。",
      "note": "稱讚穿著"
    },
    {
      "en": "Which one is bigger, the circle or the square?",
      "zh": "圓形和正方形哪個比較大？",
      "note": "比較大小"
    },
    {
      "en": "Look! There is a rainbow in the sky!",
      "zh": "看！天空有一道彩虹！",
      "note": "見到彩虹時"
    }
  ],
  "dialogues": [
    {
      "title": "在美勞課",
      "lines": [
        {
          "who": "A",
          "en": "What color do you want to use?",
          "zh": "你想用什麼顏色？"
        },
        {
          "who": "B",
          "en": "I want to use green and yellow.",
          "zh": "我想用綠色和黃色。"
        },
        {
          "who": "A",
          "en": "What are you drawing?",
          "zh": "你在畫什麼？"
        },
        {
          "who": "B",
          "en": "A big star over the blue house.",
          "zh": "藍色房子上方的一顆大星星。"
        }
      ]
    },
    {
      "title": "找形狀",
      "lines": [
        {
          "who": "A",
          "en": "Look at this box. What shape is it?",
          "zh": "看這個盒子，它是什麼形狀？"
        },
        {
          "who": "B",
          "en": "It is a cube.",
          "zh": "它是立方體。"
        },
        {
          "who": "A",
          "en": "And what about the clock?",
          "zh": "那時鐘呢？"
        },
        {
          "who": "B",
          "en": "The clock is a circle.",
          "zh": "時鐘是圓形。"
        }
      ]
    }
  ]
}
