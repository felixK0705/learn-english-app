  "dialogues": [
    {
      "title": "在公園看鳥",
      "lines": [
        {
          "who": "A",
          "en": "Look at that bird in the tree!",
          "zh": "看樹上那隻鳥！"
        },
        {
          "who": "B",
          "en": "It is a woodpecker. Listen to it tapping.",
          "zh": "那是啄木鳥，聽牠啄樹的聲音。"
        },
        {
          "who": "A",
          "en": "Where is its nest?",
          "zh": "牠的巢在哪裡？"
        },
        {
          "who": "B",
          "en": "Maybe in that big hole.",
          "zh": "也許在那個大洞裡。"
        }
      ]
    },
    {
      "title": "被蚊子叮",
      "lines": [
        {
          "who": "A",
          "en": "Ouch! A mosquito bit me again.",
          "zh": "噢！又被蚊子叮了。"
        },
        {
          "who": "B",
          "en": "Do you want some bug spray?",
          "zh": "你要不要噴一點防蚊液？"
        },
        {
          "who": "A",
          "en": "Yes, please. They love me.",
          "zh": "好，麻煩了。牠們好愛我。"
        },
        {
          "who": "B",
          "en": "Let's go inside. It is getting dark.",
          "zh": "我們進屋吧，天快黑了。"
        },
        {
          "who": "A",
          "en": "Good idea.",
          "zh": "好主意。"
        }
      ]
    }
  ]
