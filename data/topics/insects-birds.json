  "sentences": [
    {
      "en": "There is a bee on your shoulder!",
      "zh": "你肩膀上有一隻蜜蜂！",
      "note": "提醒朋友小心"
    },
    {
      "en": "Don't be afraid. It won't hurt you.",
      "zh": "別怕，牠不會傷害你。",
      "note": "安慰怕蟲的人"
    },
    {
      "en": "I got bitten by a mosquito.",
      "zh": "我被蚊子叮了。",
      "note": "抱怨被叮"
    },
    {
      "en": "Can you hear the birds singing?",
      "zh": "你聽得到鳥在唱歌嗎？",
      "note": "早晨在戶外時"
    },
    {
      "en": "What kind of bird is that?",
      "zh": "那是什麼鳥？",
      "note": "看到不認識的鳥"
    },
    {
      "en": "The caterpillar turns into a butterfly.",
      "zh": "毛毛蟲會變成蝴蝶。",
      "note": "解釋昆蟲成長"
    },
    {
      "en": "Be quiet, or you'll scare the bird.",
      "zh": "小聲點，不然會嚇到鳥。",
      "note": "靠近小鳥時"
    },
    {
      "en": "Ants work together as a team.",
      "zh": "螞蟻像團隊一樣合作。",
      "note": "聊昆蟲的特性"
    },
    {
      "en": "I saw a spider in the bathroom!",
      "zh": "我在浴室看到一隻蜘蛛！",
      "note": "告訴家人"
    },
    {
      "en": "Please close the window, or mosquitoes will come in.",
      "zh": "請關窗，不然蚊子會飛進來。",
      "note": "提醒家人"
    },
    {
      "en": "A firefly lit up the night.",
      "zh": "一隻螢火蟲照亮了夜晚。",
      "note": "描述美景"
    },
    {
      "en": "Owls sleep during the day.",
      "zh": "貓頭鷹白天睡覺。",
      "note": "說明動物習慣"
    },
    {
      "en": "Look at its colorful feathers!",
      "zh": "看牠色彩繽紛的羽毛！",
      "note": "讚嘆鳥類"
    },
    {
      "en": "Let's go bird watching this weekend.",
      "zh": "我們這個週末去賞鳥吧。",
      "note": "邀約活動"
    },
    {
      "en": "Please don't feed the pigeons.",
      "zh": "請不要餵鴿子。",
      "note": "公園規定"
    }
  ],
  "dialogues": [
    {
      "title": "在公園看鳥",
      "lines": [
        {
          "who": "A",
          "en": "Look at that bird in the tree!",
          "zh": "看樹上那隻鳥！"
        },
        {
          "who": "B",
          "en": "It's a woodpecker. Listen to it tapping.",
          "zh": "那是啄木鳥，聽牠啄樹的聲音。"
        },
        {
          "who": "A",
          "en": "Where is its nest?",
          "zh": "牠的巢在哪裡？"
        },
        {
          "who": "B",
          "en": "Maybe in that big hole.",
          "zh": "也許在那個大洞裡。"
        }
      ]
    },
    {
      "title": "被蚊子叮",
      "lines": [
        {
          "who": "A",
          "en": "Ouch! A mosquito bit me again.",
          "zh": "噢！又被蚊子叮了。"
        },
        {
          "who": "B",
          "en": "Do you want some bug spray?",
          "zh": "你要不要噴一點防蚊液？"
        },
        {
          "who": "A",
          "en": "Yes, please. They love me.",
          "zh": "好，麻煩了。牠們好愛我。"
        },
        {
          "who": "B",
          "en": "Let's go inside. It's getting dark.",
          "zh": "我們進屋吧，天快黑了。"
        },
        {
          "who": "A",
          "en": "Good idea.",
          "zh": "好主意。"
        }
      ]
    }
  ],
