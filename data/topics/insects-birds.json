  "sentences": [
    {
      "en": "There is a bee on your shoulder!",
      "zh": "你肩膀上有一隻蜜蜂！",
      "note": "提醒朋友小心"
    },
    {
      "en": "Don't be afraid. It won't hurt you.",
      "zh": "別怕，牠不會傷害你。",
      "note": "安慰怕蟲的人"
    },
    {
      "en": "I got bitten by a mosquito.",
      "zh": "我被蚊子叮了。",
      "note": "抱怨被叮"
    },
    {
      "en": "Can you hear the birds singing?",
      "zh": "你聽得到鳥在唱歌嗎？",
      "note": "早晨在戶外時"
    },
    {
      "en": "What kind of bird is that?",
      "zh": "那是什麼鳥？",
      "note": "看到不認識的鳥"
    },
    {
      "en": "The caterpillar turns into a butterfly.",
