  "sentences": [
    {
      "en": "What do you do in your free time?",
      "zh": "你空閒的時候做什麼？",
      "note": "聊興趣時最常用"
    },
    {
      "en": "My hobby is taking photos.",
      "zh": "我的嗜好是拍照。",
      "note": "介紹自己的興趣"
    },
    {
      "en": "I'm really into baking these days.",
      "zh": "我最近很迷烘焙。",
      "note": "表示最近的熱情"
    },
    {
      "en": "How long have you been doing that?",
      "zh": "你做這個多久了？",
      "note": "追問對方的興趣"
    },
    {
      "en": "I started playing chess when I was seven.",
      "zh": "我七歲開始下西洋棋。",
      "note": "說明開始的時間"
    },
    {
      "en": "Would you like to try it?",
      "zh": "你想試試看嗎？",
      "note": "邀請對方體驗"
    },
    {
      "en": "Can you teach me how to knit?",
      "zh": "你可以教我怎麼編織嗎？",
      "note": "請別人教學"
    },
    {
      "en": "I spend about two hours on it every day.",
      "zh": "我每天花大約兩小時做這件事。",
      "note": "說明投入時間"
    },
    {
      "en": "It helps me relax after school.",
      "zh": "它能幫我在放學後放鬆。",
      "note": "解釋喜歡的理由"
    },
    {
      "en": "That sounds interesting!",
      "zh": "聽起來很有趣！",
      "note": "回應對方的興趣"
    },
    {
      "en": "I have been collecting stamps for three years.",
      "zh": "我已經收集郵票三年了。",
      "note": "介紹收藏"
    },
    {
      "en": "Do you want to join our club?",
      "zh": "你想加入我們的社團嗎？",
      "note": "邀請加入"
    },
    {
      "en": "I'm not good at drawing, but I enjoy it.",
      "zh": "我不太會畫畫，但我很喜歡。",
      "note": "謙虛地說明程度"
    },
    {
      "en": "Let me show you my collection.",
      "zh": "讓我給你看我的收藏。",
      "note": "分享收藏時"
    }
  ],
  "dialogues": [
    {
      "title": "聊嗜好",
      "lines": [
        {
          "who": "A",
          "en": "What is your hobby?",
          "zh": "你的嗜好是什麼？"
        },
        {
          "who": "B",
          "en": "I love origami. I made this paper crane.",
          "zh": "我喜歡摺紙，這隻紙鶴是我做的。"
        },
        {
          "who": "A",
          "en": "Wow, it looks great! Can you teach me?",
          "zh": "哇，好漂亮！你可以教我嗎？"
        },
        {
          "who": "B",
          "en": "Sure. Come to my house on Saturday.",
          "zh": "當然，星期六來我家吧。"
        }
      ]
    },
    {
      "title": "週末計畫",
      "lines": [
        {
          "who": "A",
          "en": "What are you going to do this weekend?",
          "zh": "你這個週末要做什麼？"
        },
        {
          "who": "B",
          "en": "I'm going camping with my family.",
          "zh": "我要和家人去露營。"
        },
        {
          "who": "A",
          "en": "That sounds fun. Are you going to take photos?",
          "zh": "聽起來很有趣，你會拍照嗎？"
        },
        {
          "who": "B",
          "en": "Of course! I'll bring my new camera.",
          "zh": "當然！我會帶我的新相機。"
        }
      ]
    }
  ],
