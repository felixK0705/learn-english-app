  "sentences": [
    {
      "en": "Look at the stars tonight!",
      "zh": "看看今晚的星星！",
      "note": "仰望星空"
    },
    {
      "en": "The moon looks so big and bright.",
      "zh": "月亮看起來又大又亮。",
      "note": "賞月時"
    },
    {
      "en": "How high is that mountain?",
      "zh": "那座山有多高？",
      "note": "問山的高度"
    },
    {
      "en": "The view from the top is amazing.",
      "zh": "山頂的景色太棒了。",
      "note": "登頂時"
    },
    {
      "en": "The river is wide and deep.",
      "zh": "這條河又寬又深。",
      "note": "描述河流"
    },
    {
      "en": "Be careful near the cliff.",
      "zh": "在懸崖邊要小心。",
      "note": "提醒安全"
    },
    {
      "en": "What time is the sunset today?",
      "zh": "今天幾點日落？",
      "note": "看夕陽之前"
    },
    {
      "en": "Earth is the third planet from the sun.",
      "zh": "地球是離太陽第三近的行星。",
      "note": "科學知識"
    },
    {
      "en": "There are eight planets in our solar system.",
      "zh": "我們的太陽系有八顆行星。",
      "note": "科學知識"
    },
    {
      "en": "I want to be an astronaut someday.",
      "zh": "我有一天想成為太空人。",
      "note": "說出夢想"
    },
    {
      "en": "Can I look through the telescope?",
      "zh": "我可以用望遠鏡看看嗎？",
      "note": "在觀星活動"
    },
    {
      "en": "Did you see that shooting star?",
      "zh": "你有看到那顆流星嗎？",
      "note": "發現流星時"
    },
    {
      "en": "The forest is quiet and peaceful.",
      "zh": "森林安靜又平和。",
      "note": "描述自然"
    },
    {
      "en": "We should protect our planet.",
      "zh": "我們應該保護我們的星球。",
      "note": "環保議題"
    },
    {
      "en": "Let's go camping near the lake this weekend.",
      "zh": "這個週末我們去湖邊露營吧。",
      "note": "邀約戶外活動"
    }
  ],
  "dialogues": [
    {
      "title": "夜晚看星星",
      "lines": [
        {
          "who": "A",
          "en": "Look up! There are so many stars.",
          "zh": "抬頭看！好多星星。"
        },
        {
          "who": "B",
          "en": "I can see the Milky Way.",
          "zh": "我看得到銀河。"
        },
        {
          "who": "A",
          "en": "Is that a planet over there?",
          "zh": "那邊那個是行星嗎？"
        },
        {
          "who": "B",
          "en": "Yes, that's Venus. It's very bright.",
          "zh": "對，那是金星，非常亮。"
        },
        {
          "who": "A",
          "en": "I wish I could go to space.",
          "zh": "我好想去太空。"
        }
      ]
    },
    {
      "title": "爬山",
      "lines": [
        {
          "who": "A",
          "en": "We're almost at the top of the mountain.",
          "zh": "我們快到山頂了。"
        },
        {
          "who": "B",
          "en": "Wow, the view is amazing!",
          "zh": "哇，風景太棒了！"
        },
        {
          "who": "A",
          "en": "You can see the river and the valley.",
          "zh": "你可以看到河和山谷。"
        },
        {
          "who": "B",
          "en": "Let's wait here for the sunset.",
          "zh": "我們在這裡等日落吧。"
        }
      ]
    }
  ],
