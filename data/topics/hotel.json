  "sentences": [
    {
      "en": "I have a reservation under Chen.",
      "zh": "我用陳的名字訂了房。",
      "note": "辦理入住時"
    },
    {
      "en": "Do you have any rooms available tonight?",
      "zh": "你們今晚有空房嗎？",
      "note": "臨時詢問空房"
    },
    {
      "en": "I’d like to check in, please.",
      "zh": "我想辦理入住。",
      "note": "抵達飯店時"
    },
    {
      "en": "How much is a room per night?",
      "zh": "一晚房價多少？",
      "note": "詢問房價"
    },
    {
      "en": "Is breakfast included?",
      "zh": "有包含早餐嗎？",
      "note": "確認房價內容"
    },
    {
      "en": "What time is checkout?",
      "zh": "幾點退房？",
      "note": "詢問退房時間"
    },
    {
      "en": "Could I have a late checkout?",
      "zh": "我可以延後退房嗎？",
      "note": "想晚一點離開時"
    },
    {
      "en": "Could you send up some extra towels?",
      "zh": "可以送幾條毛巾上來嗎？",
      "note": "向櫃台提出需求"
    },
    {
      "en": "The air conditioner isn’t working.",
      "zh": "冷氣壞了。",
      "note": "回報設施問題"
    },
    {
      "en": "What is the Wi-Fi password?",
      "zh": "無線網路密碼是什麼？",
      "note": "要連網時"
    },
    {
      "en": "Can I leave my luggage here until noon?",
      "zh": "我可以把行李寄放到中午嗎？",
      "note": "退房後還要逛街時"
    },
    {
      "en": "Could you call a taxi for me?",
      "zh": "可以幫我叫計程車嗎？",
      "note": "請櫃台協助"
    },
    {
      "en": "I’d like a wake-up call at seven.",
      "zh": "我想要七點的晨喚服務。",
      "note": "需要早起時"
    },
    {
      "en": "Where is the nearest convenience store?",
      "zh": "最近的便利商店在哪裡？",
      "note": "向櫃台詢問周邊"
    }
  ],
  "dialogues": [
    {
      "title": "辦理入住",
      "lines": [
        {
          "who": "A",
          "en": "Welcome. Do you have a reservation?",
          "zh": "歡迎光臨，請問有訂房嗎？"
        },
        {
          "who": "B",
          "en": "Yes, under Wang. Two nights, one double room.",
          "zh": "有，用王的名字，雙人房兩晚。"
        },
        {
          "who": "A",
          "en": "Here is your key card. You’re in room 806.",
          "zh": "這是您的房卡，您的房間是806。"
        },
        {
          "who": "B",
          "en": "Is breakfast included?",
          "zh": "有包含早餐嗎？"
        },
        {
          "who": "A",
          "en": "Yes, from seven to ten on the first floor.",
          "zh": "有的，一樓早上七點到十點供應。"
        }
      ]
    },
    {
      "title": "房間有問題",
      "lines": [
        {
          "who": "A",
          "en": "Hello. This is room 806. The air conditioner isn’t working.",
          "zh": "您好，這裡是806房，冷氣壞了。"
        },
        {
          "who": "B",
          "en": "I’m sorry. I’ll send someone right away.",
          "zh": "很抱歉，我立刻派人過去。"
        },
        {
          "who": "A",
          "en": "Thank you. Could I also have an extra pillow?",
          "zh": "謝謝，我還可以多要一個枕頭嗎？"
        },
        {
          "who": "B",
          "en": "Of course. Housekeeping will bring one up.",
          "zh": "當然，房務人員會送上去。"
        }
      ]
    }
  ]
}
