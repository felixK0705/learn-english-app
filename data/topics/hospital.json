  "sentences": [
    {
      "en": "I don’t feel well.",
      "zh": "我覺得不舒服。",
      "note": "告訴別人身體不適"
    },
    {
      "en": "I have a fever and a sore throat.",
      "zh": "我發燒又喉嚨痛。",
      "note": "向醫生說明症狀"
    },
    {
      "en": "Where does it hurt?",
      "zh": "哪裡會痛？",
      "note": "醫生詢問疼痛部位"
    },
    {
      "en": "It hurts here.",
      "zh": "這裡會痛。",
      "note": "指出疼痛的地方"
    },
    {
      "en": "How long have you felt this way?",
      "zh": "你這樣多久了？",
      "note": "醫生詢問病程"
    },
    {
      "en": "I’d like to make an appointment.",
      "zh": "我想預約看診。",
      "note": "打電話或到櫃台掛號"
    },
    {
      "en": "Do you have your NHI card?",
      "zh": "你有帶健保卡嗎？",
      "note": "櫃台人員詢問"
    },
    {
      "en": "Are you allergic to any medicine?",
      "zh": "你對任何藥物過敏嗎？",
      "note": "醫生確認過敏史"
    },
    {
      "en": "Take this medicine three times a day.",
      "zh": "這個藥一天吃三次。",
      "note": "交代服藥方式"
    },
    {
      "en": "Take it after meals.",
      "zh": "飯後服用。",
      "note": "交代服藥時間"
    },
    {
      "en": "You should get plenty of rest.",
      "zh": "你應該多休息。",
      "note": "醫生建議"
    },
    {
      "en": "Drink a lot of water.",
      "zh": "多喝水。",
      "note": "日常健康提醒"
    },
    {
      "en": "Please call an ambulance!",
      "zh": "請叫救護車！",
      "note": "遇到緊急狀況"
    },
    {
      "en": "Is it serious?",
      "zh": "嚴重嗎？",
      "note": "擔心病情時"
    },
    {
      "en": "I hope you feel better soon.",
      "zh": "希望你早日康復。",
      "note": "慰問生病的人"
    }
  ],
  "dialogues": [
    {
      "title": "看感冒",
      "lines": [
        {
          "who": "A",
          "en": "Good morning. What seems to be the problem?",
          "zh": "早安，你哪裡不舒服？"
        },
        {
          "who": "B",
          "en": "I have a cough and a sore throat.",
          "zh": "我咳嗽又喉嚨痛。"
        },
        {
          "who": "A",
          "en": "Do you have a fever?",
          "zh": "你有發燒嗎？"
        },
        {
          "who": "B",
          "en": "Yes, a little. I feel dizzy, too.",
          "zh": "有一點，而且我覺得頭暈。"
        },
        {
          "who": "A",
          "en": "You have a cold. Take this medicine and rest.",
          "zh": "你感冒了，吃這個藥並多休息。"
        }
      ]
    },
    {
      "title": "預約看牙",
      "lines": [
        {
          "who": "A",
          "en": "Hello. I’d like to make an appointment.",
          "zh": "您好，我想預約看診。"
        },
        {
          "who": "B",
          "en": "What seems to be the problem?",
          "zh": "請問是哪裡不舒服？"
        },
        {
          "who": "A",
          "en": "I have a toothache.",
          "zh": "我牙痛。"
        },
        {
          "who": "B",
          "en": "Can you come in tomorrow at ten?",
          "zh": "明天十點你可以過來嗎？"
        },
        {
          "who": "A",
          "en": "Yes, that works. Thank you.",
          "zh": "可以，謝謝你。"
        }
      ]
    }
  ],
