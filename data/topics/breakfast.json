  "sentences": [
    {
      "en": "Good morning. What would you like?",
      "zh": "早安，請問想吃什麼？",
      "note": "店員招呼客人時"
    },
    {
      "en": "I would like a ham sandwich, please.",
      "zh": "我要一個火腿三明治。",
      "note": "點餐時"
    },
    {
      "en": "Can I have a cup of soy milk too?",
      "zh": "我也可以點一杯豆漿嗎？",
      "note": "加點飲料時"
    },
    {
      "en": "Is that for here or to go?",
      "zh": "內用還是外帶？",
      "note": "店員詢問時"
    },
    {
      "en": "To go, please.",
      "zh": "麻煩外帶。",
      "note": "選擇外帶時"
    },
    {
      "en": "No butter, please.",
      "zh": "請不要加奶油。",
      "note": "不要某種配料時"
    },
    {
      "en": "Could you add an egg?",
      "zh": "可以幫我加一顆蛋嗎？",
      "note": "加料時"
    },
    {
      "en": "Is the soy milk sweet or plain?",
      "zh": "豆漿是甜的還是無糖的？",
      "note": "詢問口味時"
    },
    {
      "en": "How long will it take?",
      "zh": "大概要等多久？",
      "note": "趕時間時"
    },
    {
      "en": "Can I get a set meal?",
      "zh": "我可以點套餐嗎？",
      "note": "想點套餐時"
    },
    {
      "en": "Please cut the sandwich in half.",
      "zh": "請把三明治切成一半。",
      "note": "請店員切開時"
    },
    {
      "en": "What is today’s special?",
      "zh": "今天的特餐是什麼？",
      "note": "想看推薦時"
    },
    {
      "en": "I am in a hurry. Please make it quick.",
      "zh": "我在趕時間，麻煩快一點。",
      "note": "趕上班上課時"
    }
  ],
  "dialogues": [
    {
      "title": "在早餐店點餐",
      "lines": [
        {
          "who": "A",
          "en": "Good morning! What can I get you?",
          "zh": "早安！要點什麼？"
        },
        {
          "who": "B",
          "en": "An egg pancake and a medium soy milk.",
          "zh": "一份蛋餅和一杯中杯豆漿。"
        },
        {
          "who": "A",
          "en": "Hot or iced?",
          "zh": "要熱的還是冰的？"
        },
        {
          "who": "B",
          "en": "Hot, with no sugar, please.",
          "zh": "熱的，不加糖。"
        },
        {
          "who": "A",
          "en": "Okay. That will be sixty dollars.",
          "zh": "好的，一共六十元。"
        }
      ]
    },
    {
      "title": "週末的早午餐",
      "lines": [
        {
          "who": "A",
          "en": "What do you want for brunch?",
          "zh": "你早午餐想吃什麼？"
        },
        {
          "who": "B",
          "en": "Pancakes with honey and fruit.",
          "zh": "鬆餅配蜂蜜和水果。"
        },
        {
          "who": "A",
          "en": "Sounds good. I will have scrambled eggs and toast.",
          "zh": "聽起來不錯，我要炒蛋和吐司。"
        },
        {
          "who": "B",
          "en": "Let us grab a table by the window.",
          "zh": "我們去坐靠窗的位子吧。"
        }
      ]
    }
  ]
}
