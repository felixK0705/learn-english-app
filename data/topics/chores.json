  "sentences": [
    {
      "en": "Can you give me a hand?",
      "zh": "你可以幫我一下嗎？",
      "note": "請人幫忙時"
    },
    {
      "en": "It is your turn to do the dishes.",
      "zh": "輪到你洗碗了。",
      "note": "分配家事時"
    },
    {
      "en": "Who is going to take out the trash?",
      "zh": "誰要去倒垃圾？",
      "note": "討論分工時"
    },
    {
      "en": "I will sweep the floor if you mop it.",
      "zh": "你拖地的話，我就來掃地。",
      "note": "互相分工時"
    },
    {
      "en": "Please clean up your room.",
      "zh": "請把你的房間打掃乾淨。",
      "note": "請孩子整理房間時"
    },
    {
      "en": "Let us do the chores together.",
      "zh": "我們一起做家事吧。",
      "note": "邀請家人一起做時"
    },
    {
      "en": "I have already folded the clothes.",
      "zh": "我已經把衣服摺好了。",
      "note": "報告完成進度時"
    },
    {
      "en": "The laundry is done. Can you hang it up?",
      "zh": "衣服洗好了，你可以去晾嗎？",
      "note": "洗衣完成後"
    },
    {
      "en": "Do not forget to recycle the bottles.",
      "zh": "別忘了回收瓶子。",
      "note": "提醒家人時"
    },
    {
      "en": "This place is a mess!",
      "zh": "這裡亂七八糟！",
      "note": "看到房間太亂時"
    },
    {
      "en": "I will take care of the dishes tonight.",
      "zh": "今晚的碗我來洗。",
      "note": "主動承擔時"
    },
    {
      "en": "Where do you keep the broom?",
      "zh": "掃把放在哪裡？",
      "note": "在別人家幫忙時"
    },
    {
      "en": "Put your dirty clothes in the basket.",
      "zh": "把髒衣服放進籃子裡。",
      "note": "提醒家人時"
    },
    {
      "en": "Thanks for helping out today.",
      "zh": "謝謝你今天的幫忙。",
      "note": "感謝別人時"
    }
  ],
  "dialogues": [
    {
      "title": "分配家事",
      "lines": [
        {
          "who": "A",
          "en": "Today is Saturday. Time for chores!",
          "zh": "今天星期六，該做家事了！"
        },
        {
          "who": "B",
          "en": "What should I do?",
          "zh": "我該做什麼？"
        },
        {
          "who": "A",
          "en": "Please sweep the floor and take out the trash.",
          "zh": "請掃地並把垃圾拿出去倒。"
        },
        {
          "who": "B",
          "en": "Okay. Can you mop after I sweep?",
          "zh": "好。我掃完你可以拖地嗎？"
        },
        {
          "who": "A",
          "en": "Sure. I will also do the laundry.",
          "zh": "沒問題。我還會洗衣服。"
        }
      ]
    },
    {
      "title": "大掃除",
      "lines": [
        {
          "who": "A",
          "en": "Wow, what a mess!",
          "zh": "哇，好亂啊！"
        },
        {
          "who": "B",
          "en": "Let us clean up together.",
          "zh": "我們一起整理吧。"
        },
        {
          "who": "A",
          "en": "I will dust the shelves. You wipe the table.",
          "zh": "我來擦架子，你擦桌子。"
        },
        {
          "who": "B",
          "en": "Deal. Where is the rag?",
          "zh": "好。抹布在哪裡？"
        },
        {
          "who": "A",
          "en": "It is in the bucket by the door.",
          "zh": "在門邊的水桶裡。"
        }
      ]
    }
  ]
}
