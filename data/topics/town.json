  "sentences": [
    {
      "en": "Where do you live?",
      "zh": "你住在哪裡？",
      "note": "詢問對方住處時"
    },
    {
      "en": "I live in a small town near Taipei.",
      "zh": "我住在台北附近的一個小鎮。",
      "note": "介紹自己住的地方"
    },
    {
      "en": "Is there a library around here?",
      "zh": "這附近有圖書館嗎？",
      "note": "向路人詢問地點"
    },
    {
      "en": "What is there to do in this city?",
      "zh": "這座城市有什麼好玩的？",
      "note": "詢問觀光或娛樂時"
    },
    {
      "en": "It’s a quiet and friendly neighborhood.",
      "zh": "那是個安靜又友善的社區。",
      "note": "形容住家環境"
    },
    {
      "en": "How long have you lived here?",
      "zh": "你在這裡住多久了？",
      "note": "閒聊對方的居住經歷"
    },
    {
      "en": "The museum is just down the street.",
      "zh": "博物館就在這條街上，不遠。",
      "note": "告訴別人地點很近"
    },
    {
      "en": "The city is very crowded on weekends.",
      "zh": "這座城市週末非常擁擠。",
      "note": "形容城市的狀況"
    },
    {
      "en": "Let’s meet in front of the cinema.",
      "zh": "我們在電影院前面碰面吧。",
      "note": "約定見面地點"
    },
    {
      "en": "This town is famous for its night markets.",
      "zh": "這個小鎮以夜市聞名。",
      "note": "介紹家鄉特色"
    },
    {
      "en": "Can you recommend a good café nearby?",
      "zh": "你能推薦附近一家不錯的咖啡廳嗎？",
      "note": "請人推薦店家"
    },
    {
      "en": "I need to stop by the pharmacy first.",
      "zh": "我得先順道去一下藥局。",
      "note": "說明行程中要先去某處"
    },
    {
      "en": "Everything is within walking distance.",
      "zh": "所有東西都在步行可到的範圍內。",
      "note": "形容生活很方便"
    },
    {
      "en": "Be careful when you cross the street.",
      "zh": "過馬路時要小心。",
      "note": "提醒別人注意安全"
    }
  ],
  "dialogues": [
    {
      "title": "介紹自己的城市",
      "lines": [
        {
          "who": "A",
          "en": "Where are you from?",
          "zh": "你是哪裡人？"
        },
        {
          "who": "B",
          "en": "I’m from Tainan. It’s an old city.",
          "zh": "我來自台南，那是一座古老的城市。"
        },
        {
          "who": "A",
          "en": "What is it famous for?",
          "zh": "它以什麼聞名？"
        },
        {
          "who": "B",
          "en": "It’s famous for its temples and street food.",
          "zh": "它以廟宇和路邊小吃聞名。"
        },
        {
          "who": "A",
          "en": "That sounds great. I want to visit!",
          "zh": "聽起來很棒，我想去看看！"
        }
      ]
    },
    {
      "title": "找一家咖啡廳",
      "lines": [
        {
          "who": "A",
          "en": "Excuse me, is there a café around here?",
          "zh": "不好意思，這附近有咖啡廳嗎？"
        },
        {
          "who": "B",
          "en": "Yes, there is one next to the bookstore.",
          "zh": "有的，在書店隔壁有一家。"
        },
        {
          "who": "A",
          "en": "Is it far from here?",
          "zh": "離這裡遠嗎？"
        },
        {
          "who": "B",
          "en": "No, it’s only five minutes away on foot.",
          "zh": "不遠，走路只要五分鐘。"
        },
        {
          "who": "A",
          "en": "Thank you so much!",
          "zh": "非常謝謝你！"
        }
      ]
    }
  ],
