  "sentences": [
    {
      "en": "What time do you get up?",
      "zh": "你幾點起床？",
      "note": "詢問作息時"
    },
    {
      "en": "I usually get up at six thirty.",
      "zh": "我通常六點半起床。",
      "note": "說明自己的作息時"
    },
    {
      "en": "What's your daily routine like?",
      "zh": "你每天的作息是怎麼樣的？",
      "note": "想了解別人的生活時"
    },
    {
      "en": "I eat breakfast, and then I go to school.",
      "zh": "我吃完早餐就去上學。",
      "note": "描述早上的事情時"
    },
    {
      "en": "How do you get to school?",
      "zh": "你怎麼去學校？",
      "note": "詢問交通方式時"
    },
    {
      "en": "I take the bus to school.",
      "zh": "我搭公車上學。",
      "note": "回答交通方式時"
    },
    {
      "en": "What time does school start?",
      "zh": "學校幾點開始上課？",
      "note": "詢問上課時間時"
    },
    {
      "en": "School starts at eight and ends at four.",
      "zh": "學校八點開始，四點結束。",
      "note": "說明上課時間時"
    },
    {
      "en": "I'm running late!",
      "zh": "我要遲到了！",
      "note": "趕時間時"
    },
    {
      "en": "I do my homework right after school.",
      "zh": "我一放學就寫功課。",
      "note": "說明課後安排時"
    },
    {
      "en": "What do you do on weekends?",
      "zh": "你週末都做什麼？",
      "note": "聊週末活動時"
    },
    {
      "en": "I never stay up past eleven.",
      "zh": "我從不熬夜超過十一點。",
      "note": "說明自己的習慣時"
    },
    {
      "en": "Time to get up. Breakfast is ready.",
      "zh": "該起床了，早餐好了。",
      "note": "叫家人起床時"
    },
    {
      "en": "It's getting late. Let's go home.",
      "zh": "時間不早了，我們回家吧。",
      "note": "準備結束活動時"
    }
  ],
  "dialogues": [
    {
      "title": "聊作息",
      "lines": [
        {
          "who": "A",
          "en": "What time do you get up?",
          "zh": "你幾點起床？"
        },
        {
          "who": "B",
          "en": "I usually get up at six thirty.",
          "zh": "我通常六點半起床。"
        },
        {
          "who": "A",
          "en": "Wow, that's early! What do you do next?",
          "zh": "哇，好早！然後你做什麼？"
        },
        {
          "who": "B",
          "en": "I brush my teeth, get dressed, and eat breakfast. Then I take the bus to school.",
          "zh": "我刷牙、換衣服，然後吃早餐。接著我搭公車去上學。"
        },
        {
          "who": "A",
          "en": "That sounds like a busy morning!",
          "zh": "聽起來早上很忙呢！"
        }
      ]
    },
    {
      "title": "放學後",
      "lines": [
        {
          "who": "A",
          "en": "What do you do after school?",
          "zh": "你放學後做什麼？"
        },
        {
          "who": "B",
          "en": "I go home and have a snack.",
          "zh": "我回家吃點心。"
        },
        {
          "who": "A",
          "en": "Do you do your homework right away?",
          "zh": "你馬上寫功課嗎？"
        },
        {
          "who": "B",
          "en": "Yes, I always finish it before dinner.",
          "zh": "對，我總是在晚餐前寫完。"
        },
        {
          "who": "A",
          "en": "Good habit! When is your bedtime?",
          "zh": "好習慣！你幾點睡覺？"
        }
      ]
    }
  ],
