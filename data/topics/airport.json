  "dialogues": [
    {
      "title": "辦理登機",
      "lines": [
        {
          "who": "A",
          "en": "Good morning. May I see your passport?",
          "zh": "早安，請讓我看您的護照。"
        },
        {
          "who": "B",
          "en": "Here you are. Can I have a window seat?",
          "zh": "在這裡。我可以要靠窗的座位嗎？"
        },
        {
          "who": "A",
          "en": "Sure. Do you have any bags to check?",
          "zh": "沒問題。您有行李要託運嗎？"
        },
        {
          "who": "B",
          "en": "Just this suitcase. I’ll keep my carry-on.",
          "zh": "只有這個行李箱，隨身行李我自己帶。"
        },
        {
          "who": "A",
          "en": "Here is your boarding pass. Your gate is twelve.",
          "zh": "這是您的登機證，登機門是十二號。"
        }
      ]
    },
    {
      "title": "入境審查",
      "lines": [
        {
          "who": "A",
          "en": "What is the purpose of your visit?",
          "zh": "您來訪的目的是什麼？"
        },
        {
          "who": "B",
          "en": "I’m here on vacation.",
          "zh": "我是來度假的。"
        },
        {
          "who": "A",
          "en": "How long will you stay?",
          "zh": "您要停留多久？"
        },
        {
          "who": "B",
          "en": "For one week.",
          "zh": "一星期。"
        },
        {
          "who": "A",
          "en": "Enjoy your stay.",
          "zh": "祝您旅途愉快。"
        }
      ]
    }
  ]
