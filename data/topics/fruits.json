  "sentences": [
    {
      "en": "How much are the strawberries?",
      "zh": "草莓怎麼賣？",
      "note": "詢問價格時"
    },
    {
      "en": "Can I try one?",
      "zh": "我可以試吃一個嗎？",
      "note": "想試吃時"
    },
    {
      "en": "Is this one sweet?",
      "zh": "這個甜嗎？",
      "note": "詢問甜不甜"
    },
    {
      "en": "Please pick a ripe one for me.",
      "zh": "請幫我挑一顆熟的。",
      "note": "請老闆挑水果時"
    },
    {
      "en": "I would like two pounds of apples.",
      "zh": "我要兩磅蘋果。",
      "note": "指定購買重量時"
    },
    {
      "en": "Are these mangoes in season?",
      "zh": "這些芒果是當季的嗎？",
      "note": "詢問是否盛產"
    },
    {
      "en": "Could you cut it for me?",
      "zh": "可以幫我切一下嗎？",
      "note": "請老闆切水果時"
    },
    {
      "en": "Can I get a discount if I buy more?",
      "zh": "多買可以算便宜一點嗎？",
      "note": "討價還價時"
    },
    {
      "en": "I am allergic to kiwi.",
      "zh": "我對奇異果過敏。",
      "note": "說明過敏時"
    },
    {
      "en": "This one is too sour for me.",
      "zh": "這個對我來說太酸了。",
      "note": "表達口味偏好時"
    },
    {
      "en": "What is your favorite fruit?",
      "zh": "你最喜歡的水果是什麼？",
      "note": "聊天找話題時"
    },
    {
      "en": "Please put them in a bag.",
      "zh": "請幫我裝袋。",
      "note": "結帳時"
    },
    {
      "en": "Fruit is good for your health.",
      "zh": "水果對健康有益。",
      "note": "勸人多吃水果時"
    },
    {
      "en": "These are fresh from the farm.",
      "zh": "這些是產地直送的。",
      "note": "老闆介紹水果時"
    }
  ],
  "dialogues": [
    {
      "title": "在水果攤",
      "lines": [
        {
          "who": "A",
          "en": "Hi! How much are the grapes?",
          "zh": "嗨！葡萄怎麼賣？"
        },
        {
          "who": "B",
          "en": "They are one hundred dollars a bunch.",
          "zh": "一串一百元。"
        },
        {
          "who": "A",
          "en": "Can I try one first?",
          "zh": "我可以先試吃一顆嗎？"
        },
        {
          "who": "B",
          "en": "Sure. They are very sweet.",
          "zh": "當然，它們很甜。"
        },
        {
          "who": "A",
          "en": "Great! I will take two bunches.",
          "zh": "太好了！我要兩串。"
        }
      ]
    },
    {
      "title": "選一顆好西瓜",
      "lines": [
        {
          "who": "A",
          "en": "Is this watermelon ripe?",
          "zh": "這顆西瓜熟了嗎？"
        },
        {
          "who": "B",
          "en": "Knock on it. It sounds ripe to me.",
          "zh": "敲敲看，聽起來是熟的。"
        },
        {
          "who": "A",
          "en": "Can you cut it in half?",
          "zh": "可以幫我切成一半嗎？"
        },
        {
          "who": "B",
          "en": "No problem. Here you are.",
          "zh": "沒問題，給你。"
        }
      ]
    }
  ]
}
