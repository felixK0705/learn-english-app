  "sentences": [
    {
      "en": "Look at that giraffe!",
      "zh": "看那隻長頸鹿！",
      "note": "發現有趣動物時"
    },
    {
      "en": "Which animal do you like best?",
      "zh": "你最喜歡哪種動物？",
      "note": "聊喜好時"
    },
    {
      "en": "What does a panda eat?",
      "zh": "貓熊吃什麼？",
      "note": "詢問動物習性"
    },
    {
      "en": "Pandas eat bamboo.",
      "zh": "貓熊吃竹子。",
      "note": "回答動物吃什麼"
    },
    {
      "en": "It's as tall as a house.",
      "zh": "牠像房子一樣高。",
      "note": "形容動物的大小"
    },
    {
      "en": "Where is the elephant house?",
      "zh": "大象館在哪裡？",
      "note": "在園區問路"
    },
    {
      "en": "Don't tap on the glass.",
      "zh": "不要敲玻璃。",
      "note": "提醒別打擾動物"
    },
    {
      "en": "What time is the feeding show?",
      "zh": "餵食秀是幾點？",
      "note": "詢問表演時間"
    },
    {
      "en": "The monkey is so funny!",
      "zh": "那隻猴子好好笑！",
      "note": "表達感想"
    },
    {
      "en": "Can we see the penguins next?",
      "zh": "我們接下來可以去看企鵝嗎？",
      "note": "提議下一站"
    },
    {
      "en": "I'm afraid of snakes.",
      "zh": "我怕蛇。",
      "note": "說出害怕的動物"
    },
    {
      "en": "Let's take a photo together.",
      "zh": "我們一起拍張照吧。",
      "note": "想合照時"
    },
    {
      "en": "This animal lives in Africa.",
      "zh": "這種動物住在非洲。",
      "note": "介紹動物棲地"
    },
    {
      "en": "How fast can a cheetah run?",
      "zh": "獵豹能跑多快？",
      "note": "好奇動物能力"
    },
    {
      "en": "It's time to go home.",
      "zh": "該回家了。",
      "note": "逛完動物園準備離開"
    }
  ],
  "dialogues": [
    {
      "title": "在動物園問路",
      "lines": [
        {
          "who": "A",
          "en": "Excuse me, where are the pandas?",
          "zh": "不好意思，貓熊在哪裡？"
        },
        {
          "who": "B",
          "en": "Go straight and turn left.",
          "zh": "直走然後左轉。"
        },
        {
          "who": "A",
          "en": "Is it far from here?",
          "zh": "離這裡很遠嗎？"
        },
        {
          "who": "B",
          "en": "No, it's only five minutes away.",
          "zh": "不遠，只要五分鐘。"
        },
        {
          "who": "A",
          "en": "Thank you very much.",
          "zh": "非常謝謝你。"
        }
      ]
    },
    {
      "title": "看猴子",
      "lines": [
        {
          "who": "A",
          "en": "Look! The monkey is eating a banana.",
          "zh": "看！猴子在吃香蕉。"
        },
        {
          "who": "B",
          "en": "It's so cute!",
          "zh": "好可愛喔！"
        },
        {
          "who": "A",
          "en": "Can I take a picture?",
          "zh": "我可以拍照嗎？"
        },
        {
          "who": "B",
          "en": "Sure, but don't use the flash.",
          "zh": "當然可以，但不要開閃光燈。"
        }
      ]
    }
  ]
}
