  "sentences": [
    {
      "en": "Let's go to the beach!",
      "zh": "我們去海邊吧！",
      "note": "邀請朋友去海邊"
    },
    {
      "en": "The water is nice and warm.",
      "zh": "海水又溫暖又舒服。",
      "note": "形容水溫"
    },
    {
      "en": "Is it safe to swim here?",
      "zh": "在這裡游泳安全嗎？",
      "note": "詢問安全"
    },
    {
      "en": "Don't swim too far from the shore.",
      "zh": "不要游離岸邊太遠。",
      "note": "提醒安全"
    },
    {
      "en": "Did you put on sunscreen?",
      "zh": "你擦防曬了嗎？",
      "note": "出發前提醒"
    },
    {
      "en": "Look at that huge wave!",
      "zh": "看那個好大的浪！",
      "note": "看到大浪時"
    },
    {
      "en": "I found a really pretty shell.",
      "zh": "我找到一個很漂亮的貝殼。",
      "note": "分享發現"
    },
    {
      "en": "What time is high tide?",
      "zh": "幾點漲潮？",
      "note": "詢問潮汐時間"
    },
    {
      "en": "Can you help me bury my feet?",
      "zh": "你可以幫我把腳埋起來嗎？",
      "note": "玩沙時"
    },
    {
      "en": "I'm going to rent a surfboard.",
      "zh": "我要去租一塊衝浪板。",
      "note": "計畫活動"
    },
    {
      "en": "Watch out for jellyfish.",
      "zh": "小心水母。",
      "note": "提醒危險"
    },
    {
      "en": "The sunset over the sea is beautiful.",
      "zh": "海上的夕陽好美。",
      "note": "欣賞風景"
    },
    {
      "en": "Dolphins are very smart animals.",
      "zh": "海豚是非常聰明的動物。",
      "note": "聊海洋生物"
    },
    {
      "en": "I'm getting sunburned.",
      "zh": "我快曬傷了。",
      "note": "覺得太陽太大時"
    },
    {
      "en": "We should clean up the trash on the beach.",
      "zh": "我們應該清理海灘上的垃圾。",
      "note": "環保提醒"
    }
  ],
  "dialogues": [
    {
      "title": "在海邊",
      "lines": [
        {
          "who": "A",
          "en": "The water looks great. Let's go swimming!",
          "zh": "海水看起來很棒，我們去游泳吧！"
        },
        {
          "who": "B",
          "en": "Wait, did you put on sunscreen?",
          "zh": "等一下，你擦防曬了嗎？"
        },
        {
          "who": "A",
          "en": "Oh, not yet. Can you pass it to me?",
          "zh": "噢，還沒。可以拿給我嗎？"
        },
        {
          "who": "B",
          "en": "Here you are. Don't go too far.",
          "zh": "給你。不要游太遠。"
        }
      ]
    },
    {
      "title": "潮間帶發現",
      "lines": [
        {
          "who": "A",
          "en": "Look! There is a crab under the rock.",
          "zh": "看！岩石下面有一隻螃蟹。"
        },
        {
          "who": "B",
          "en": "Wow, it is so small!",
          "zh": "哇，好小喔！"
        },
        {
          "who": "A",
          "en": "Let's not touch it.",
          "zh": "我們不要碰牠。"
        },
        {
          "who": "B",
          "en": "Right. We will put the shell back too.",
          "zh": "對，我們也把貝殼放回去。"
        },
        {
          "who": "A",
          "en": "Good idea.",
          "zh": "好主意。"
        }
      ]
    }
  ]
}
