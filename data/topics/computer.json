  "dialogues": [
    {
      "title": "電腦出問題",
      "lines": [
        {
          "who": "A",
          "en": "My computer will not turn on.",
          "zh": "我的電腦打不開。"
        },
        {
          "who": "B",
          "en": "Is it plugged in?",
          "zh": "有插電嗎？"
        },
        {
          "who": "A",
          "en": "Oh, the cable came out. Thanks!",
          "zh": "噢，電線掉了。謝謝！"
        },
        {
          "who": "B",
          "en": "No problem. Now it works.",
          "zh": "不客氣，現在可以用了。"
        }
      ]
    },
    {
      "title": "在咖啡廳上網",
      "lines": [
        {
          "who": "A",
          "en": "Excuse me, is there Wi-Fi here?",
          "zh": "不好意思，這裡有無線網路嗎？"
        },
        {
          "who": "B",
          "en": "Yes. The password is on the menu.",
          "zh": "有，密碼在菜單上。"
        },
        {
          "who": "A",
          "en": "Thank you. Could I also charge my phone?",
          "zh": "謝謝，我也可以幫手機充電嗎？"
        },
        {
          "who": "B",
          "en": "Sure. The outlet is by the window.",
          "zh": "可以，插座在窗邊。"
        }
      ]
    }
  ]
