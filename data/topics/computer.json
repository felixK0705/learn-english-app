  "sentences": [
    {
      "en": "How do I connect to the Wi-Fi?",
      "zh": "我要怎麼連上無線網路？",
      "note": "到新地方想上網時"
    },
    {
      "en": "What is the Wi-Fi password?",
      "zh": "無線網路密碼是什麼？",
      "note": "詢問密碼"
    },
    {
      "en": "My computer isn't working.",
      "zh": "我的電腦壞了。",
      "note": "尋求協助時"
    },
    {
      "en": "The screen is frozen.",
      "zh": "螢幕當機了。",
      "note": "電腦卡住時"
    },
    {
      "en": "Could you help me print this file?",
      "zh": "你可以幫我列印這個檔案嗎？",
      "note": "請別人幫忙印東西"
    },
    {
      "en": "Please save your work often.",
      "zh": "請經常存檔。",
      "note": "提醒備份"
    },
    {
      "en": "I'll send you the link.",
      "zh": "我會把連結寄給你。",
      "note": "分享網址"
    },
    {
      "en": "Let me check my email.",
      "zh": "讓我看一下我的電子郵件。",
      "note": "查看信件前"
    },
    {
      "en": "Can you hear me? Please turn on your microphone.",
      "zh": "你聽得到我嗎？請打開麥克風。",
      "note": "視訊會議時"
    },
    {
      "en": "The battery is low. I need a charger.",
      "zh": "電量不足，我需要充電器。",
      "note": "手機或電腦沒電時"
    },
    {
      "en": "Don't click on strange links.",
      "zh": "不要點奇怪的連結。",
      "note": "提醒網路安全"
    },
    {
      "en": "Where can I download this app?",
      "zh": "我可以在哪裡下載這個應用程式？",
      "note": "詢問如何取得程式"
    },
    {
      "en": "I forgot my password.",
      "zh": "我忘記密碼了。",
      "note": "登入失敗時"
    },
    {
      "en": "The internet is very slow today.",
      "zh": "今天網路很慢。",
      "note": "抱怨網速"
    }
  ],
  "dialogues": [
    {
      "title": "電腦出問題",
      "lines": [
        {
          "who": "A",
          "en": "My computer won't turn on.",
          "zh": "我的電腦打不開。"
        },
        {
          "who": "B",
          "en": "Is it plugged in?",
          "zh": "有插電嗎？"
        },
        {
          "who": "A",
          "en": "Oh, the plug came out. Thanks!",
          "zh": "噢，插頭掉了。謝謝！"
        },
        {
          "who": "B",
          "en": "No problem. Now it works.",
          "zh": "不客氣，現在可以用了。"
        }
      ]
    },
    {
      "title": "在咖啡廳上網",
      "lines": [
        {
          "who": "A",
          "en": "Excuse me, is there Wi-Fi here?",
          "zh": "不好意思，這裡有無線網路嗎？"
        },
        {
          "who": "B",
          "en": "Yes. The password is on the menu.",
          "zh": "有，密碼在菜單上。"
        },
        {
          "who": "A",
          "en": "Thank you. Could I also charge my phone?",
          "zh": "謝謝，我也可以幫手機充電嗎？"
        },
        {
          "who": "B",
          "en": "Sure. The outlet is by the window.",
          "zh": "可以，插座在窗邊。"
        }
      ]
    }
  ],
