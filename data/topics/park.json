  "sentences": [
    {
      "en": "Let us go to the park!",
      "zh": "我們去公園吧！",
      "note": "邀請朋友出門玩"
    },
    {
      "en": "Do you want to go on the swings?",
      "zh": "你想去玩鞦韆嗎？",
      "note": "在遊樂場邀請玩伴"
    },
    {
      "en": "Wait for your turn, please.",
      "zh": "請等輪到你。",
      "note": "提醒排隊玩設施"
    },
    {
      "en": "Be careful! The slide is wet.",
      "zh": "小心！滑梯是濕的。",
      "note": "提醒安全"
    },
    {
      "en": "Push me higher!",
      "zh": "把我推高一點！",
      "note": "玩鞦韆時"
    },
    {
      "en": "Can I play with you?",
      "zh": "我可以和你們一起玩嗎？",
      "note": "想加入別人遊戲時"
    },
    {
      "en": "Look at the ducks on the pond!",
      "zh": "看池塘裡的鴨子！",
      "note": "引起同伴注意"
    },
    {
      "en": "It is such a beautiful day.",
      "zh": "今天天氣真好。",
      "note": "讚嘆好天氣"
    },
    {
      "en": "Let us sit on the bench and rest.",
      "zh": "我們坐在長椅上休息吧。",
      "note": "走累時"
    },
    {
      "en": "Please do not litter.",
      "zh": "請不要亂丟垃圾。",
      "note": "提醒公共禮儀"
    },
    {
      "en": "Keep your dog on a leash.",
      "zh": "請牽好你的狗。",
      "note": "提醒遛狗規定"
    },
    {
      "en": "I will race you to the tree!",
      "zh": "我跟你比賽誰先跑到那棵樹！",
      "note": "玩跑步遊戲"
    },
    {
      "en": "It is getting late. Time to go home.",
      "zh": "天色晚了，該回家了。",
      "note": "結束玩耍時"
    },
    {
      "en": "Can I have an ice cream, please?",
      "zh": "我可以吃冰淇淋嗎？",
      "note": "向家人撒嬌或向店員購買"
    }
  ],
  "dialogues": [
    {
      "title": "在遊樂場認識朋友",
      "lines": [
        {
          "who": "A",
          "en": "Hi! Can I play with you?",
          "zh": "嗨！我可以和你們一起玩嗎？"
        },
        {
          "who": "B",
          "en": "Sure! We are playing tag.",
          "zh": "當然！我們在玩鬼抓人。"
        },
        {
          "who": "A",
          "en": "Great. Who is it?",
          "zh": "太好了，誰當鬼？"
        },
        {
          "who": "B",
          "en": "Mia is it. Run!",
          "zh": "小米當鬼，快跑！"
        }
      ]
    },
    {
      "title": "野餐",
      "lines": [
        {
          "who": "A",
          "en": "Where should we put the blanket?",
          "zh": "毯子要鋪在哪裡？"
        },
        {
          "who": "B",
          "en": "Under that big tree.",
          "zh": "那棵大樹下面。"
        },
        {
          "who": "A",
          "en": "I brought sandwiches and juice.",
          "zh": "我帶了三明治和果汁。"
        },
        {
          "who": "B",
          "en": "Yum! Let us have a picnic.",
          "zh": "好棒！我們開始野餐吧。"
        }
      ]
    }
  ]
}
