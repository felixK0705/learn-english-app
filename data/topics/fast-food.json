  "sentences": [
    {
      "en": "Hi, can I get a cheeseburger combo?",
      "zh": "嗨，我可以點一份起司漢堡套餐嗎？",
      "note": "點套餐時"
    },
    {
      "en": "What would you like to drink?",
      "zh": "你想喝什麼飲料？",
      "note": "店員詢問時"
    },
    {
      "en": "A medium cola, please.",
      "zh": "請給我中杯可樂。",
      "note": "選飲料時"
    },
    {
      "en": "Can I get that without pickles?",
      "zh": "可以不要酸黃瓜嗎？",
      "note": "客製餐點時"
    },
    {
      "en": "Would you like fries with that?",
      "zh": "要搭配薯條嗎？",
      "note": "店員推薦時"
    },
    {
      "en": "Can I upgrade to a large?",
      "zh": "我可以升級成大的嗎？",
      "note": "想升級尺寸時"
    },
    {
      "en": "For here or to go?",
      "zh": "內用還是外帶？",
      "note": "店員詢問時"
    },
    {
      "en": "It's for here.",
      "zh": "內用。",
      "note": "選擇內用時"
    },
    {
      "en": "Is that everything?",
      "zh": "這樣就好了嗎？",
      "note": "店員確認時"
    },
    {
      "en": "That's all, thanks.",
      "zh": "這樣就好，謝謝。",
      "note": "點完餐時"
    },
    {
      "en": "Do you take credit cards?",
      "zh": "你們收信用卡嗎？",
      "note": "結帳時"
    },
    {
      "en": "Could I get some extra napkins?",
      "zh": "可以多給我一些紙巾嗎？",
      "note": "需要紙巾時"
    },
    {
      "en": "Is my order ready yet?",
      "zh": "我的餐點好了嗎？",
      "note": "等候取餐時"
    },
    {
      "en": "I have a coupon. Can I use it?",
      "zh": "我有優惠券，可以使用嗎？",
      "note": "使用優惠時"
    },
    {
      "en": "Where can I get a refill?",
      "zh": "哪裡可以續杯？",
      "note": "想再裝飲料時"
    }
  ],
  "dialogues": [
    {
      "title": "在櫃檯點餐",
      "lines": [
        {
          "who": "A",
          "en": "Welcome! What can I get for you?",
          "zh": "歡迎光臨！要點什麼？"
        },
        {
          "who": "B",
          "en": "One burger combo, please.",
          "zh": "請給我一份漢堡套餐。"
        },
        {
          "who": "A",
          "en": "Would you like to make it large?",
          "zh": "要換成大份嗎？"
        },
        {
          "who": "B",
          "en": "No, medium is fine. For here, please.",
          "zh": "不用，中份就好，內用。"
        },
        {
          "who": "A",
          "en": "Okay. Your order number is fifteen.",
          "zh": "好的，您的號碼是十五號。"
        }
      ]
    },
    {
      "title": "得來速",
      "lines": [
        {
          "who": "A",
          "en": "Hello. I'd like six nuggets and a small cola.",
          "zh": "你好，我要六塊雞塊和一杯小可樂。"
        },
        {
          "who": "B",
          "en": "Anything else?",
          "zh": "還需要什麼嗎？"
        },
        {
          "who": "A",
          "en": "Yes, some extra ketchup, please.",
          "zh": "有，請多給我一些番茄醬。"
        },
        {
          "who": "B",
          "en": "Please drive to the first window.",
          "zh": "請開到第一個窗口。"
        }
      ]
    }
  ]
}
