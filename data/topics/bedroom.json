  "sentences": [
    {
      "en": "It's time for bed.",
      "zh": "該睡覺了。",
      "note": "提醒孩子就寢時"
    },
    {
      "en": "Good night. Sleep tight.",
      "zh": "晚安，好好睡。",
      "note": "睡前道晚安時"
    },
    {
      "en": "Sweet dreams!",
      "zh": "祝你有個好夢！",
      "note": "睡前祝福時"
    },
    {
      "en": "Did you sleep well?",
      "zh": "你睡得好嗎？",
      "note": "早上見面時"
    },
    {
      "en": "I couldn't fall asleep last night.",
      "zh": "我昨晚睡不著。",
      "note": "睡眠不好時"
    },
    {
      "en": "I'm so sleepy.",
      "zh": "我好睏。",
      "note": "想睡覺時"
    },
    {
      "en": "Can you turn off the light, please?",
      "zh": "可以請你關燈嗎？",
      "note": "準備睡覺時"
    },
    {
      "en": "Don't forget to set your alarm.",
      "zh": "別忘了設鬧鐘。",
      "note": "提醒隔天要早起時"
    },
    {
      "en": "I have to get up at six tomorrow.",
      "zh": "我明天六點就要起床。",
      "note": "說明明天的行程時"
    },
    {
      "en": "Please make your bed.",
      "zh": "請整理你的床。",
      "note": "請孩子整理房間時"
    },
    {
      "en": "Clean your room before dinner.",
      "zh": "晚餐前把你的房間整理乾淨。",
      "note": "請孩子打掃房間時"
    },
    {
      "en": "I need another blanket. It's cold.",
      "zh": "我需要多一條毯子，好冷。",
      "note": "覺得冷時"
    },
    {
      "en": "Wake up! You'll be late.",
      "zh": "起床了！你會遲到的。",
      "note": "叫人起床時"
    },
    {
      "en": "I stayed up too late last night.",
      "zh": "我昨晚熬夜熬太晚了。",
      "note": "解釋為什麼很累時"
    }
  ],
  "dialogues": [
    {
      "title": "睡前",
      "lines": [
        {
          "who": "A",
          "en": "It's ten o'clock. Time for bed.",
          "zh": "十點了，該睡覺了。"
        },
        {
          "who": "B",
          "en": "Can I read for five more minutes?",
          "zh": "我可以再看五分鐘書嗎？"
        },
        {
          "who": "A",
          "en": "Okay, but then turn off the light.",
          "zh": "好吧，但之後要關燈。"
        },
        {
          "who": "B",
          "en": "I will. Good night, Mom.",
          "zh": "我會的。晚安，媽媽。"
        },
        {
          "who": "A",
          "en": "Good night. Sweet dreams!",
          "zh": "晚安，祝你有個好夢！"
        }
      ]
    },
    {
      "title": "早上叫起床",
      "lines": [
        {
          "who": "A",
          "en": "Wake up! It's already seven.",
          "zh": "起床了！已經七點了。"
        },
        {
          "who": "B",
          "en": "Five more minutes, please.",
          "zh": "請再讓我睡五分鐘。"
        },
        {
          "who": "A",
          "en": "No way. You'll be late for school.",
          "zh": "不行，你上學會遲到。"
        },
        {
          "who": "B",
          "en": "Oh no! I forgot to set the alarm.",
          "zh": "糟了！我忘了設鬧鐘。"
        },
        {
          "who": "A",
          "en": "Hurry up and make your bed.",
          "zh": "快點，把床鋪好。"
        }
      ]
    }
  ]
}
