  "sentences": [
    {
      "en": "How does it taste?",
      "zh": "嚐起來怎麼樣？",
      "note": "詢問味道時"
    },
    {
      "en": "It tastes really good.",
      "zh": "很好吃。",
      "note": "稱讚食物時"
    },
    {
      "en": "It's a little too salty.",
      "zh": "有點太鹹了。",
      "note": "覺得味道偏重時"
    },
    {
      "en": "Is this dish sweet or sour?",
      "zh": "這道菜是甜的還是酸的？",
      "note": "詢問口味時"
    },
    {
      "en": "Can you make it less spicy?",
      "zh": "可以做不那麼辣嗎？",
      "note": "點餐時要求減辣"
    },
    {
      "en": "I like my meat well done.",
      "zh": "我的肉要全熟。",
      "note": "表達喜好時"
    },
    {
      "en": "What's the secret ingredient?",
      "zh": "秘方食材是什麼？",
      "note": "好奇料理時"
    },
    {
      "en": "First, chop the garlic.",
      "zh": "首先，把大蒜切碎。",
      "note": "說明食譜步驟時"
    },
    {
      "en": "Then fry it until it's golden brown.",
      "zh": "然後煎到金黃色。",
      "note": "說明烹調步驟時"
    },
    {
      "en": "Add some salt and pepper.",
      "zh": "加一些鹽和胡椒。",
      "note": "教人調味時"
    },
    {
      "en": "Be careful. The pan is very hot.",
      "zh": "小心，鍋子很燙。",
      "note": "提醒安全時"
    },
    {
      "en": "Do you have a good recipe for soup?",
      "zh": "你有好的湯食譜嗎？",
      "note": "請教食譜時"
    },
    {
      "en": "It needs more flavor.",
      "zh": "它需要更多味道。",
      "note": "覺得味道不夠時"
    },
    {
      "en": "This is too greasy for me.",
      "zh": "這個對我來說太油了。",
      "note": "表達不喜歡時"
    },
    {
      "en": "Could you cook it a little longer?",
      "zh": "可以再煮久一點嗎？",
      "note": "覺得沒熟時"
    }
  ],
  "dialogues": [
    {
      "title": "試吃新菜",
      "lines": [
        {
          "who": "A",
          "en": "Try this soup. How does it taste?",
          "zh": "喝喝看這碗湯，味道如何？"
        },
        {
          "who": "B",
          "en": "It's delicious, but a little salty.",
          "zh": "很好喝，但有點鹹。"
        },
        {
          "who": "A",
          "en": "I'll add some water.",
          "zh": "我再加一點水。"
        },
        {
          "who": "B",
          "en": "Good idea. Maybe a pinch of sugar too.",
          "zh": "好主意，也許再加一小撮糖。"
        }
      ]
    },
    {
      "title": "教朋友做蛋炒飯",
      "lines": [
        {
          "who": "A",
          "en": "What do I do first?",
          "zh": "我第一步要做什麼？"
        },
        {
          "who": "B",
          "en": "Chop the green onion, then heat the pan.",
          "zh": "先把蔥切碎，然後熱鍋。"
        },
        {
          "who": "A",
          "en": "Okay. Can I fry the egg now?",
          "zh": "好了，現在可以煎蛋了嗎？"
        },
        {
          "who": "B",
          "en": "Yes, then add the rice and stir well.",
          "zh": "對，然後加飯下去拌勻。"
        }
      ]
    }
  ],
