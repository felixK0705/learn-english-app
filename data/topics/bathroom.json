  "sentences": [
    {
      "en": "Where's the bathroom?",
      "zh": "請問洗手間在哪裡？",
      "note": "在外面或別人家詢問時"
    },
    {
      "en": "May I use the bathroom?",
      "zh": "我可以借用洗手間嗎？",
      "note": "向別人借廁所時"
    },
    {
      "en": "Someone is in there.",
      "zh": "裡面有人。",
      "note": "廁所被占用時"
    },
    {
      "en": "Hurry up! I need to use the toilet.",
      "zh": "快一點！我要上廁所。",
      "note": "很急的時候"
    },
    {
      "en": "Can I take a shower first?",
      "zh": "我可以先洗澡嗎？",
      "note": "與家人輪流使用浴室時"
    },
    {
      "en": "The water is too hot.",
      "zh": "水太燙了。",
      "note": "調整水溫時"
    },
    {
      "en": "Could you turn up the hot water?",
      "zh": "可以把熱水開大一點嗎？",
      "note": "水不夠熱時"
    },
    {
      "en": "We're out of toilet paper.",
      "zh": "我們沒有衛生紙了。",
      "note": "需要補貨時"
    },
    {
      "en": "Pass me a towel, please.",
      "zh": "請把毛巾遞給我。",
      "note": "洗完澡需要毛巾時"
    },
    {
      "en": "Don't forget to brush your teeth.",
      "zh": "別忘了刷牙。",
      "note": "提醒孩子時"
    },
    {
      "en": "Please don't leave the floor wet.",
      "zh": "請不要把地板弄得濕濕的。",
      "note": "提醒家人時"
    },
    {
      "en": "The sink is clogged.",
      "zh": "洗手台堵住了。",
      "note": "排水不通時"
    },
    {
      "en": "Turn off the water when you brush.",
      "zh": "刷牙時要把水關掉。",
      "note": "提醒節約用水時"
    },
    {
      "en": "I'm done. The bathroom is free now.",
      "zh": "我好了，浴室現在沒人了。",
      "note": "用完浴室通知別人時"
    }
  ],
  "dialogues": [
    {
      "title": "早上搶浴室",
      "lines": [
        {
          "who": "A",
          "en": "Are you done in the bathroom yet?",
          "zh": "你在浴室好了嗎？"
        },
        {
          "who": "B",
          "en": "Almost. I'm rinsing off the shampoo.",
          "zh": "快好了，我在沖掉洗髮精。"
        },
        {
          "who": "A",
          "en": "Please hurry. I need to wash my face.",
          "zh": "請快一點，我要洗臉。"
        },
        {
          "who": "B",
          "en": "Okay. Pass me a towel, please.",
          "zh": "好，請把毛巾遞給我。"
        },
        {
          "who": "A",
          "en": "Here you go. Don't forget your slippers.",
          "zh": "給你。別忘了穿拖鞋。"
        }
      ]
    },
    {
      "title": "在朋友家",
      "lines": [
        {
          "who": "A",
          "en": "Excuse me, may I use the bathroom?",
          "zh": "不好意思，我可以借用洗手間嗎？"
        },
        {
          "who": "B",
          "en": "Sure. It's the second door on the left.",
          "zh": "當然，左邊第二道門。"
        },
        {
          "who": "A",
          "en": "Thanks. Is there any soap?",
          "zh": "謝謝。有肥皂嗎？"
        },
        {
          "who": "B",
          "en": "Yes, it's next to the basin.",
          "zh": "有，在洗臉盆旁邊。"
        }
      ]
    }
  ],
