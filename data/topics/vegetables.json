  "dialogues": [
    {
      "title": "在菜市場",
      "lines": [
        {
          "who": "A",
          "en": "Good morning! How much is the broccoli?",
          "zh": "早安！青花菜怎麼賣？"
        },
        {
          "who": "B",
          "en": "Two for fifty dollars.",
          "zh": "兩顆五十元。"
        },
        {
          "who": "A",
          "en": "Are they fresh?",
          "zh": "它們新鮮嗎？"
        },
        {
          "who": "B",
          "en": "Yes, they came in this morning.",
          "zh": "是的，今天早上才進貨。"
        },
        {
          "who": "A",
          "en": "Great. I'll take four.",
          "zh": "太好了，我要四顆。"
        }
      ]
    },
    {
      "title": "幫忙準備晚餐",
      "lines": [
        {
          "who": "A",
          "en": "What are we having for dinner?",
          "zh": "我們晚餐吃什麼？"
        },
        {
          "who": "B",
          "en": "Vegetable soup. Can you wash the carrots?",
          "zh": "蔬菜湯。你可以洗紅蘿蔔嗎？"
        },
        {
          "who": "A",
          "en": "Sure. Should I peel them too?",
          "zh": "好啊。要削皮嗎？"
        },
        {
          "who": "B",
          "en": "Yes, and cut them into small pieces.",
          "zh": "要，還要切成小塊。"
        }
      ]
    }
  ]
}
