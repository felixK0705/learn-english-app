  "sentences": [
    {
      "en": "May I go to the restroom?",
      "zh": "我可以去上廁所嗎？",
      "note": "上課中需要離開教室時"
    },
    {
      "en": "Could you say that again, please?",
      "zh": "可以請你再說一次嗎？",
      "note": "沒聽清楚老師說的話時"
    },
    {
      "en": "I don't understand this question.",
      "zh": "我不懂這個問題。",
      "note": "遇到不會的題目時"
    },
    {
      "en": "Please open your books to page twenty.",
      "zh": "請把書翻到第二十頁。",
      "note": "老師指示課本頁數時"
    },
    {
      "en": "Can I borrow your pencil?",
      "zh": "我可以借你的鉛筆嗎？",
      "note": "忘記帶文具時"
    },
    {
      "en": "I forgot my homework at home.",
      "zh": "我把作業忘在家裡了。",
      "note": "向老師說明沒帶作業時"
    },
    {
      "en": "Who has the red marker?",
      "zh": "誰有紅色的白板筆？",
      "note": "找東西時"
    },
    {
      "en": "Please be quiet and listen.",
      "zh": "請安靜並仔細聽。",
      "note": "要同學安靜時"
    },
    {
      "en": "What does this word mean?",
      "zh": "這個字是什麼意思？",
      "note": "詢問單字意思時"
    },
    {
      "en": "Can you help me with this problem?",
      "zh": "你可以幫我解這一題嗎？",
      "note": "向同學求助時"
    },
    {
      "en": "It's time for class.",
      "zh": "該上課了。",
      "note": "提醒大家進教室時"
    },
    {
      "en": "Please sit down and take out your notebook.",
      "zh": "請坐下並拿出筆記本。",
      "note": "老師開始上課時"
    },
    {
      "en": "Whose backpack is this?",
      "zh": "這是誰的書包？",
      "note": "發現遺失物品時"
    },
    {
      "en": "Class is over. See you tomorrow!",
      "zh": "下課了，明天見！",
      "note": "一天課程結束時"
    }
  ],
  "dialogues": [
    {
      "title": "借東西",
      "lines": [
        {
          "who": "A",
          "en": "Excuse me, do you have an extra eraser?",
          "zh": "不好意思，你有多的橡皮擦嗎？"
        },
        {
          "who": "B",
          "en": "Yes, here you are.",
          "zh": "有，給你。"
        },
        {
          "who": "A",
          "en": "Thank you! I'll give it back after class.",
          "zh": "謝謝！下課後我會還你。"
        },
        {
          "who": "B",
          "en": "No problem. You can keep it.",
          "zh": "沒關係，你可以留著。"
        }
      ]
    },
    {
      "title": "忘記帶作業",
      "lines": [
        {
          "who": "A",
          "en": "Where is your homework, Tom?",
          "zh": "你的作業呢，湯姆？"
        },
        {
          "who": "B",
          "en": "I'm sorry. I left it at home.",
          "zh": "對不起，我把它忘在家裡了。"
        },
        {
          "who": "A",
          "en": "Please hand it in tomorrow.",
          "zh": "請明天交。"
        },
        {
          "who": "B",
          "en": "Yes, I'll bring it. Thank you, Ms. Lin.",
          "zh": "好的，我會帶來。謝謝林老師。"
        }
      ]
    }
  ],
