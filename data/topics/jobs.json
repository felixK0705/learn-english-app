  "sentences": [
    {
      "en": "What do you do?",
      "zh": "你從事什麼工作？",
      "note": "詢問對方職業時"
    },
    {
      "en": "I'm a teacher.",
      "zh": "我是老師。",
      "note": "說明自己的職業時"
    },
    {
      "en": "She works in a hospital.",
      "zh": "她在醫院工作。",
      "note": "說明別人的工作地點時"
    },
    {
      "en": "What does your father do?",
      "zh": "你爸爸做什麼工作？",
      "note": "詢問家人職業時"
    },
    {
      "en": "My father is an engineer.",
      "zh": "我爸爸是工程師。",
      "note": "回答家人職業時"
    },
    {
      "en": "What do you want to be when you grow up?",
      "zh": "你長大想做什麼？",
      "note": "詢問未來夢想時"
    },
    {
      "en": "I want to be a doctor.",
      "zh": "我想當醫生。",
      "note": "說出夢想時"
    },
    {
      "en": "Do you like your job?",
      "zh": "你喜歡你的工作嗎？",
      "note": "詢問對工作的感受時"
    },
    {
      "en": "I work from nine to five.",
      "zh": "我從九點上班到五點。",
      "note": "說明工作時間時"
    },
    {
      "en": "He is looking for a new job.",
      "zh": "他正在找新工作。",
      "note": "談論求職時"
    },
    {
      "en": "She is good at talking to people.",
      "zh": "她很擅長與人交談。",
      "note": "稱讚某人適合某種工作時"
    },
    {
      "en": "Being a nurse is hard work.",
      "zh": "當護士是辛苦的工作。",
      "note": "談論工作辛苦時"
    },
    {
      "en": "I have an interview tomorrow.",
      "zh": "我明天有面試。",
      "note": "提到面試時"
    },
    {
      "en": "How long have you worked here?",
      "zh": "你在這裡工作多久了？",
      "note": "詢問工作資歷時"
    },
    {
      "en": "That's a very important job.",
      "zh": "那是個很重要的工作。",
      "note": "表達敬意時"
    }
  ],
  "dialogues": [
    {
      "title": "聊職業",
      "lines": [
        {
          "who": "A",
          "en": "What do you do, Mr. Wang?",
          "zh": "王先生，你從事什麼工作？"
        },
        {
          "who": "B",
          "en": "I'm a firefighter. How about you?",
          "zh": "我是消防員。你呢？"
        },
        {
          "who": "A",
          "en": "I'm a nurse at the city hospital.",
          "zh": "我是市立醫院的護士。"
        },
        {
          "who": "B",
          "en": "That's a very important job.",
          "zh": "那是個很重要的工作。"
        },
        {
          "who": "A",
          "en": "So is yours!",
          "zh": "你的也是！"
        }
      ]
    },
    {
      "title": "談夢想",
      "lines": [
        {
          "who": "A",
          "en": "What do you want to be when you grow up?",
          "zh": "你長大想做什麼？"
        },
        {
          "who": "B",
          "en": "I want to be a vet. I love animals.",
          "zh": "我想當獸醫，我愛動物。"
        },
        {
          "who": "A",
          "en": "You're good at taking care of pets.",
          "zh": "你很擅長照顧寵物。"
        },
        {
          "who": "B",
          "en": "Thanks. What about you?",
          "zh": "謝謝，你呢？"
        },
        {
          "who": "A",
          "en": "I want to be a pilot.",
          "zh": "我想當飛行員。"
        }
      ]
    }
  ]
