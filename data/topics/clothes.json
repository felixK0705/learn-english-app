  "sentences": [
    {
      "en": "Can I try this on?",
      "zh": "我可以試穿這個嗎？",
      "note": "想試穿衣服時"
    },
    {
      "en": "Where is the fitting room?",
      "zh": "試衣間在哪裡？",
      "note": "找試衣間"
    },
    {
      "en": "Do you have this in a medium?",
      "zh": "這件有M號嗎？",
      "note": "詢問尺寸"
    },
    {
      "en": "It’s a little too tight.",
      "zh": "這有點太緊了。",
      "note": "試穿後覺得不合身"
    },
    {
      "en": "Do you have a bigger size?",
      "zh": "你們有大一點的尺寸嗎？",
      "note": "要換更大的尺寸"
    },
    {
      "en": "Do you have this in another color?",
      "zh": "這件有其他顏色嗎？",
      "note": "詢問顏色"
    },
    {
      "en": "How much is this jacket?",
      "zh": "這件外套多少錢？",
      "note": "詢問價格"
    },
    {
      "en": "I’m just looking, thank you.",
      "zh": "我只是看看，謝謝。",
      "note": "婉拒店員招呼"
    },
    {
      "en": "It looks great on you.",
      "zh": "你穿起來很好看。",
      "note": "稱讚別人的穿著"
    },
    {
      "en": "I’ll take it.",
      "zh": "我要買這個。",
      "note": "決定購買時"
    },
    {
      "en": "Can I exchange this for a different size?",
      "zh": "我可以換別的尺寸嗎？",
      "note": "要換貨時"
    },
    {
      "en": "This isn’t my style.",
      "zh": "這不是我喜歡的風格。",
      "note": "婉拒不喜歡的款式"
    },
    {
      "en": "What is this made of?",
      "zh": "這是什麼材質做的？",
      "note": "詢問衣服材質"
    },
    {
      "en": "You should wear a jacket. It’s cold.",
      "zh": "你應該穿件外套，天氣很冷。",
      "note": "提醒別人保暖"
    }
  ],
  "dialogues": [
    {
      "title": "試穿衣服",
      "lines": [
        {
          "who": "A",
          "en": "Hi, can I try on this dress?",
          "zh": "嗨，我可以試穿這件洋裝嗎？"
        },
        {
          "who": "B",
          "en": "Of course. The fitting room is over there.",
          "zh": "當然可以，試衣間在那邊。"
        },
        {
          "who": "A",
          "en": "It’s a little tight. Do you have a bigger size?",
          "zh": "有點緊，有大一點的尺寸嗎？"
        },
        {
          "who": "B",
          "en": "Yes, here is a large.",
          "zh": "有的，這是L號。"
        },
        {
          "who": "A",
          "en": "Perfect. It looks great on you!",
          "zh": "太好了，你穿起來很好看！"
        }
      ]
    },
    {
      "title": "買鞋子",
      "lines": [
        {
          "who": "A",
          "en": "Excuse me, I’m looking for sneakers.",
          "zh": "不好意思，我在找運動鞋。"
        },
        {
          "who": "B",
          "en": "What size do you wear?",
          "zh": "你穿幾號？"
        },
        {
          "who": "A",
          "en": "Size eight, please.",
          "zh": "八號，麻煩你。"
        },
        {
          "who": "B",
          "en": "Here you are. How do they feel?",
          "zh": "請看，感覺如何？"
        },
        {
          "who": "A",
          "en": "They fit well. I’ll take them.",
          "zh": "很合腳，我要買。"
        }
      ]
    }
  ]
}
