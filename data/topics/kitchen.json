  "sentences": [
    {
      "en": "What is for dinner tonight?",
      "zh": "今晚晚餐吃什麼？",
      "note": "詢問晚餐內容時"
    },
    {
      "en": "Dinner is ready!",
      "zh": "開飯囉！",
      "note": "叫大家來吃飯時"
    },
    {
      "en": "Can you help me set the table?",
      "zh": "你可以幫我擺餐具嗎？",
      "note": "請人幫忙時"
    },
    {
      "en": "Could you pass me the salt?",
      "zh": "可以把鹽遞給我嗎？",
      "note": "在餐桌上請人傳東西時"
    },
    {
      "en": "Be careful. The pot is very hot.",
      "zh": "小心，鍋子很燙。",
      "note": "提醒別人安全時"
    },
    {
      "en": "How long should I cook the noodles?",
      "zh": "麵要煮多久？",
      "note": "詢問烹調時間時"
    },
    {
      "en": "We are out of eggs.",
      "zh": "我們的蛋用完了。",
      "note": "發現食材不夠時"
    },
    {
      "en": "Let me wash these vegetables first.",
      "zh": "我先來洗這些蔬菜。",
      "note": "準備做菜時"
    },
    {
      "en": "Is there anything I can do to help?",
      "zh": "有什麼我可以幫忙的嗎？",
      "note": "想幫忙做飯時"
    },
    {
      "en": "Please turn down the heat.",
      "zh": "請把火關小一點。",
      "note": "火太大時"
    },
    {
      "en": "Something smells good!",
      "zh": "聞起來好香！",
      "note": "稱讚料理時"
    },
    {
      "en": "Would you like some more soup?",
      "zh": "你還想再喝點湯嗎？",
      "note": "招待客人時"
    },
    {
      "en": "I am full. Thank you for the delicious meal.",
      "zh": "我吃飽了，謝謝你準備的美味餐點。",
      "note": "用餐結束時"
    },
    {
      "en": "Please put the milk back in the refrigerator.",
      "zh": "請把牛奶放回冰箱。",
      "note": "提醒家人時"
    }
  ],
  "dialogues": [
    {
      "title": "一起做晚餐",
      "lines": [
        {
          "who": "A",
          "en": "What are you cooking?",
          "zh": "你在煮什麼？"
        },
        {
          "who": "B",
          "en": "I am making fried rice. Can you chop the onion?",
          "zh": "我在做炒飯。你可以切洋蔥嗎？"
        },
        {
          "who": "A",
          "en": "Sure. Where is the cutting board?",
          "zh": "好啊。砧板在哪裡？"
        },
        {
          "who": "B",
          "en": "It is in the cupboard under the sink.",
          "zh": "在水槽下面的櫃子裡。"
        },
        {
          "who": "A",
          "en": "Got it. Is the pan hot yet?",
          "zh": "拿到了。鍋子熱了嗎？"
        }
      ]
    },
    {
      "title": "開飯前",
      "lines": [
        {
          "who": "A",
          "en": "Dinner is almost ready. Please set the table.",
          "zh": "晚餐快好了，請擺餐具。"
        },
        {
          "who": "B",
          "en": "Okay. Do we need chopsticks or forks?",
          "zh": "好。我們要放筷子還是叉子？"
        },
        {
          "who": "A",
          "en": "Chopsticks, please. And a spoon for the soup.",
          "zh": "請放筷子，還有喝湯用的湯匙。"
        },
        {
          "who": "B",
          "en": "Done! It smells so good.",
          "zh": "好了！聞起來好香。"
        }
      ]
    }
  ]
}
