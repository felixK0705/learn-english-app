  "sentences": [
    {
      "en": "What's wrong?",
      "zh": "怎麼了？",
      "note": "關心對方不舒服時"
    },
    {
      "en": "My head hurts.",
      "zh": "我頭痛。",
      "note": "說明頭部不舒服時"
    },
    {
      "en": "I have a pain in my back.",
      "zh": "我的背很痛。",
      "note": "說明哪裡疼痛時"
    },
    {
      "en": "Where does it hurt?",
      "zh": "哪裡會痛？",
      "note": "醫生或家人詢問痛處時"
    },
    {
      "en": "It hurts right here.",
      "zh": "就痛在這裡。",
      "note": "指出痛的位置時"
    },
    {
      "en": "Open your mouth and say ah.",
      "zh": "張開嘴巴說「啊」。",
      "note": "看醫生檢查喉嚨時"
    },
    {
      "en": "Please raise your right hand.",
      "zh": "請舉起你的右手。",
      "note": "課堂或遊戲指令時"
    },
    {
      "en": "Touch your toes.",
      "zh": "碰你的腳趾。",
      "note": "做體操或遊戲時"
    },
    {
      "en": "Wash your hands before you eat.",
      "zh": "吃飯前要洗手。",
      "note": "提醒衛生習慣時"
    },
    {
      "en": "I need to brush my teeth.",
      "zh": "我要去刷牙。",
      "note": "準備睡覺或出門前"
    },
    {
      "en": "Be careful with your knee.",
      "zh": "小心你的膝蓋。",
      "note": "提醒對方注意受傷處時"
    },
    {
      "en": "She has beautiful eyes.",
      "zh": "她有一雙漂亮的眼睛。",
      "note": "稱讚別人外貌時"
    },
    {
      "en": "Stand up straight and keep your back straight.",
      "zh": "站直，背要挺直。",
      "note": "提醒姿勢時"
    },
    {
      "en": "My foot is asleep.",
      "zh": "我的腳麻了。",
      "note": "形容肢體發麻時"
    },
    {
      "en": "Keep your body warm.",
      "zh": "要保持身體溫暖。",
      "note": "提醒天冷保暖時"
    }
  ],
  "dialogues": [
    {
      "title": "看醫生",
      "lines": [
        {
          "who": "A",
          "en": "What's wrong?",
          "zh": "怎麼了？"
        },
        {
          "who": "B",
          "en": "My stomach hurts, and I have a headache.",
          "zh": "我肚子痛，而且頭也痛。"
        },
        {
          "who": "A",
          "en": "Open your mouth and say ah.",
          "zh": "張開嘴巴說「啊」。"
        },
        {
          "who": "B",
          "en": "Ah. Is it serious?",
          "zh": "啊。嚴重嗎？"
        },
        {
          "who": "A",
          "en": "No. Rest and drink more water.",
          "zh": "不嚴重。多休息，多喝水。"
        }
      ]
    },
    {
      "title": "體育課",
      "lines": [
        {
          "who": "A",
          "en": "Touch your toes, class.",
          "zh": "同學們，碰你們的腳趾。"
        },
        {
          "who": "B",
          "en": "Ouch! My back hurts.",
          "zh": "噢！我的背好痛。"
        },
        {
          "who": "A",
          "en": "Stop and sit down. Don't hurt yourself.",
          "zh": "停下來坐下，不要弄傷自己。"
        },
        {
          "who": "B",
          "en": "Thank you, Ms. Lin.",
          "zh": "謝謝林老師。"
        }
      ]
    }
  ]
