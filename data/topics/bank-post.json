  "sentences": [
    {
      "en": "I’d like to open an account.",
      "zh": "我想要開戶。",
      "note": "在銀行開新帳戶"
    },
    {
      "en": "I’d like to deposit this check.",
      "zh": "我想存入這張支票。",
      "note": "存款時"
    },
    {
      "en": "I’d like to withdraw some money.",
      "zh": "我想領一些錢。",
      "note": "提款時"
    },
    {
      "en": "Could you check my account balance?",
      "zh": "你可以查一下我的帳戶餘額嗎？",
      "note": "查詢餘額"
    },
    {
      "en": "How much is the transfer fee?",
      "zh": "轉帳手續費多少？",
      "note": "詢問費用"
    },
    {
      "en": "What is the exchange rate for U.S. dollars today?",
      "zh": "今天美元的匯率是多少？",
      "note": "換外幣時"
    },
    {
      "en": "Could you break this into smaller bills?",
      "zh": "你可以把這張換成小鈔嗎？",
      "note": "需要零錢時"
    },
    {
      "en": "Do I need to fill out a form?",
      "zh": "我需要填表格嗎？",
      "note": "辦理手續時"
    },
    {
      "en": "Please sign here and show your ID.",
      "zh": "請在這裡簽名並出示證件。",
      "note": "行員請客戶辦理"
    },
    {
      "en": "My card is stuck in the ATM.",
      "zh": "我的卡被提款機吃掉了。",
      "note": "提款機出狀況"
    },
    {
      "en": "I’d like to send this package to Japan.",
      "zh": "我想把這個包裹寄到日本。",
      "note": "在郵局寄包裹"
    },
    {
      "en": "How long will it take to arrive?",
      "zh": "要多久才會寄到？",
      "note": "詢問寄送時間"
    },
    {
      "en": "How much is the postage?",
      "zh": "郵資多少錢？",
      "note": "詢問郵資"
    },
    {
      "en": "Could I have two stamps, please?",
      "zh": "請給我兩張郵票。",
      "note": "買郵票"
    },
    {
      "en": "Can I track this package online?",
      "zh": "我可以在網路上追蹤這個包裹嗎？",
      "note": "詢問包裹查詢方式"
    }
  ],
  "dialogues": [
    {
      "title": "在銀行開戶",
      "lines": [
        {
          "who": "A",
          "en": "Hello. I’d like to open an account.",
          "zh": "您好，我想開戶。"
        },
        {
          "who": "B",
          "en": "Sure. May I see your ID?",
          "zh": "好的，可以看一下您的證件嗎？"
        },
        {
          "who": "A",
          "en": "Here you are. Is there a fee?",
          "zh": "在這裡。要收手續費嗎？"
        },
        {
          "who": "B",
          "en": "No fee. Please fill out this form and sign your name.",
          "zh": "不用，請填寫這張表格並簽名。"
        },
        {
          "who": "A",
          "en": "Thank you. Here is your passbook.",
          "zh": "謝謝，這是您的存摺。"
        }
      ]
    },
    {
      "title": "在郵局寄包裹",
      "lines": [
        {
          "who": "A",
          "en": "Hi. I’d like to send this package to Japan.",
          "zh": "嗨，我想把這個包裹寄到日本。"
        },
        {
          "who": "B",
          "en": "Let me weigh it. It will be eight hundred dollars.",
          "zh": "我來秤重，一共八百元。"
        },
        {
          "who": "A",
          "en": "How long will it take?",
          "zh": "要多久會寄到？"
        },
        {
          "who": "B",
          "en": "About five days. Here is your tracking number.",
          "zh": "大約五天，這是您的追蹤號碼。"
        },
        {
          "who": "A",
          "en": "Great, thank you.",
          "zh": "太好了，謝謝。"
        }
      ]
    }
  ],
