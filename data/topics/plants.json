  "sentences": [
    {
      "en": "What a beautiful flower!",
      "zh": "好漂亮的花！",
      "note": "讚美花朵"
    },
    {
      "en": "It smells so good.",
      "zh": "它聞起來好香。",
      "note": "聞花香時"
    },
    {
      "en": "How often should I water this plant?",
      "zh": "這棵植物多久要澆一次水？",
      "note": "詢問照顧方法"
    },
    {
      "en": "This plant needs a lot of sunlight.",
      "zh": "這棵植物需要很多陽光。",
      "note": "說明植物需求"
    },
    {
      "en": "I planted these tulips last fall.",
      "zh": "這些鬱金香是我去年秋天種的。",
      "note": "介紹自己的花園"
    },
    {
      "en": "The leaves are turning yellow.",
      "zh": "葉子變黃了。",
      "note": "發現植物不健康"
    },
    {
      "en": "Please keep off the grass.",
      "zh": "請勿踐踏草坪。",
      "note": "公園告示"
    },
    {
      "en": "The roses are in full bloom.",
      "zh": "玫瑰花開得正盛。",
      "note": "描述花季"
    },
    {
      "en": "Can you help me pull the weeds?",
      "zh": "你可以幫我拔雜草嗎？",
      "note": "請人幫忙"
    },
    {
      "en": "I'd like a bouquet of daisies, please.",
      "zh": "我想要一束雛菊。",
      "note": "在花店買花"
    },
    {
      "en": "Don't forget to put the cactus in the sun.",
      "zh": "別忘了把仙人掌放到太陽下。",
      "note": "提醒照顧植物"
    },
    {
      "en": "Seeds need soil, water, and sunshine.",
      "zh": "種子需要土壤、水和陽光。",
      "note": "說明植物生長"
    },
    {
      "en": "These flowers will look great in a vase.",
      "zh": "這些花插在花瓶裡會很好看。",
      "note": "布置家裡"
    },
    {
      "en": "We're going to the flower market on Sunday.",
      "zh": "我們星期天要去花市。",
      "note": "計畫行程"
    },
    {
      "en": "I'm allergic to pollen.",
      "zh": "我對花粉過敏。",
      "note": "說明身體狀況"
    }
  ],
  "dialogues": [
    {
      "title": "在花店",
      "lines": [
        {
          "who": "A",
          "en": "Hello, can I help you?",
          "zh": "你好，需要什麼嗎？"
        },
        {
          "who": "B",
          "en": "I'd like a bouquet of roses.",
          "zh": "我想要一束玫瑰花。"
        },
        {
          "who": "A",
          "en": "Sure. Red or pink?",
          "zh": "好的，紅色還是粉紅色？"
        },
        {
          "who": "B",
          "en": "Pink, please. They're for my mother.",
          "zh": "請給我粉紅色的，是要送我媽媽的。"
        },
        {
          "who": "A",
          "en": "She will love them.",
          "zh": "她一定會很喜歡。"
        }
      ]
    },
    {
      "title": "照顧植物",
      "lines": [
        {
          "who": "A",
          "en": "The leaves on this plant are turning yellow.",
          "zh": "這棵植物的葉子變黃了。"
        },
        {
          "who": "B",
          "en": "Maybe it needs more sunlight.",
          "zh": "也許它需要更多陽光。"
        },
        {
          "who": "A",
          "en": "I water it every day.",
          "zh": "我每天都幫它澆水。"
        },
        {
          "who": "B",
          "en": "That might be too much. Try twice a week.",
          "zh": "那可能太多了，試試一週兩次。"
        }
      ]
    }
  ],
