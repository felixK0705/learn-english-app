  "dialogues": [
    {
      "title": "找東西",
      "lines": [
        {
          "who": "A",
          "en": "Where's my phone?",
          "zh": "我的手機在哪裡？"
        },
        {
          "who": "B",
          "en": "Is it on the table?",
          "zh": "它在桌上嗎？"
        },
        {
          "who": "A",
          "en": "No, it isn't there.",
          "zh": "不在那裡。"
        },
        {
          "who": "B",
          "en": "Look under the cushion.",
          "zh": "找一下靠墊下面。"
        },
        {
          "who": "A",
          "en": "Found it! It was between the cushions.",
          "zh": "找到了！它在靠墊中間。"
        }
      ]
    },
    {
      "title": "問路",
      "lines": [
        {
          "who": "A",
          "en": "Excuse me, where is the library?",
          "zh": "不好意思，圖書館在哪裡？"
        },
        {
          "who": "B",
          "en": "Go straight and turn right at the corner.",
          "zh": "直走，在轉角右轉。"
        },
        {
          "who": "A",
          "en": "Is it far from here?",
          "zh": "離這裡遠嗎？"
        },
        {
          "who": "B",
          "en": "No, it's next to the bank.",
          "zh": "不遠，它在銀行旁邊。"
        },
        {
          "who": "A",
          "en": "Thank you so much!",
          "zh": "非常謝謝你！"
        }
      ]
    }
  ]
}
