  "sentences": [
    {
      "en": "Where's my phone?",
      "zh": "我的手機在哪裡？",
      "note": "找東西時"
    },
    {
      "en": "It's on the table.",
      "zh": "它在桌子上。",
      "note": "回答位置時"
    },
    {
      "en": "Look under the bed.",
      "zh": "去床底下找找。",
      "note": "提示尋找位置時"
    },
    {
      "en": "It's between the sofa and the lamp.",
      "zh": "它在沙發和檯燈之間。",
      "note": "說明東西的位置時"
    },
    {
      "en": "Who is standing behind you?",
      "zh": "誰站在你後面？",
      "note": "詢問位置時"
    },
    {
      "en": "The post office is next to the bank.",
      "zh": "郵局在銀行旁邊。",
      "note": "指路時"
    },
    {
      "en": "Go straight and turn left at the corner.",
      "zh": "直走，在轉角左轉。",
      "note": "指路時"
    },
    {
      "en": "It's across from the park.",
      "zh": "它在公園對面。",
      "note": "描述地點位置時"
    },
    {
      "en": "Is the restroom near here?",
      "zh": "洗手間在這附近嗎？",
      "note": "詢問地點時"
    },
    {
      "en": "Put the box on top of the shelf.",
      "zh": "把箱子放在架子頂端。",
      "note": "請人放東西時"
    },
    {
      "en": "Please sit in the front.",
      "zh": "請坐在前面。",
      "note": "安排座位時"
    },
    {
      "en": "I'm standing in front of the school.",
      "zh": "我正站在學校前面。",
      "note": "告訴朋友自己位置時"
    },
    {
      "en": "It's far from here. We should take the bus.",
      "zh": "離這裡很遠，我們應該搭公車。",
      "note": "討論距離時"
    },
    {
      "en": "The keys are inside my bag.",
      "zh": "鑰匙在我的包包裡面。",
      "note": "說明物品位置時"
    }
  ],
  "dialogues": [
    {
      "title": "找東西",
      "lines": [
        {
          "who": "A",
          "en": "Where's my phone?",
          "zh": "我的手機在哪裡？"
        },
        {
          "who": "B",
          "en": "Is it on the table?",
          "zh": "它在桌上嗎？"
        },
        {
          "who": "A",
          "en": "No, it isn't there.",
          "zh": "不在那裡。"
        },
        {
          "who": "B",
          "en": "Look under the cushion.",
          "zh": "找一下靠墊下面。"
        },
        {
          "who": "A",
          "en": "Found it! It was between the cushions.",
          "zh": "找到了！它在靠墊中間。"
        }
      ]
    },
    {
      "title": "問路",
      "lines": [
        {
          "who": "A",
          "en": "Excuse me, where is the library?",
          "zh": "不好意思，圖書館在哪裡？"
        },
        {
          "who": "B",
          "en": "Go straight and turn right at the corner.",
          "zh": "直走，在轉角右轉。"
        },
        {
          "who": "A",
          "en": "Is it far from here?",
          "zh": "離這裡遠嗎？"
        },
        {
          "who": "B",
          "en": "No, it's next to the bank.",
          "zh": "不遠，它在銀行旁邊。"
        },
        {
          "who": "A",
          "en": "Thank you so much!",
          "zh": "非常謝謝你！"
        }
      ]
    }
  ],
