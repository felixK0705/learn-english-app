  "sentences": [
    {
      "en": "Hello, I'm Amy.",
      "zh": "哈囉，我是艾咪。",
      "note": "自我介紹時"
    },
    {
      "en": "My name is Tom. What's yours?",
      "zh": "我叫湯姆。你呢？",
      "note": "交換名字時"
    },
    {
      "en": "Nice to meet you.",
      "zh": "很高興認識你。",
      "note": "第一次見面時"
    },
    {
      "en": "Nice to meet you, too.",
      "zh": "我也很高興認識你。",
      "note": "回應對方的問候時"
    },
    {
      "en": "How are you today?",
      "zh": "你今天好嗎？",
      "note": "日常問候時"
    },
    {
      "en": "I'm fine, thank you. And you?",
      "zh": "我很好，謝謝。你呢？",
      "note": "回答「你好嗎」時"
    },
    {
      "en": "Where are you from?",
      "zh": "你來自哪裡？",
      "note": "詢問對方家鄉或國家時"
    },
    {
      "en": "I'm from Taiwan.",
      "zh": "我來自台灣。",
      "note": "說明自己來自哪裡時"
    },
    {
      "en": "This is my friend, Jenny.",
      "zh": "這位是我的朋友珍妮。",
      "note": "介紹朋友給別人認識時"
    },
    {
      "en": "Long time no see!",
      "zh": "好久不見！",
      "note": "遇到很久沒見的人時"
    },
    {
      "en": "Good morning, everyone.",
      "zh": "大家早安。",
      "note": "早上向多人打招呼時"
    },
    {
      "en": "Good night. See you tomorrow.",
      "zh": "晚安，明天見。",
      "note": "晚上道別時"
    },
    {
      "en": "Please call me Jason.",
      "zh": "請叫我傑森。",
      "note": "告訴別人怎麼稱呼你時"
    },
    {
      "en": "Welcome to my home.",
      "zh": "歡迎來我家。",
      "note": "迎接客人時"
    },
    {
      "en": "Take care and see you soon.",
      "zh": "保重，很快再見。",
      "note": "道別時"
    }
  ],
  "dialogues": [
    {
      "title": "第一次見面",
      "lines": [
        {
          "who": "A",
          "en": "Hello, my name is Amy.",
          "zh": "哈囉，我叫艾咪。"
        },
        {
          "who": "B",
          "en": "Hi, Amy. I'm Tom. Nice to meet you.",
          "zh": "嗨，艾咪。我是湯姆，很高興認識你。"
        },
        {
          "who": "A",
          "en": "Nice to meet you, too. Where are you from?",
          "zh": "我也很高興認識你。你來自哪裡？"
        },
        {
          "who": "B",
          "en": "I'm from Taichung. How about you?",
          "zh": "我來自台中。你呢？"
        },
        {
          "who": "A",
          "en": "I live in Taipei now.",
          "zh": "我現在住在台北。"
        }
      ]
    },
    {
      "title": "早上遇到鄰居",
      "lines": [
        {
          "who": "A",
          "en": "Good morning, Mr. Chen!",
          "zh": "陳先生，早安！"
        },
        {
          "who": "B",
          "en": "Good morning, Ben. How are you?",
          "zh": "早安，班。你好嗎？"
        },
        {
          "who": "A",
          "en": "I'm fine, thank you. And you?",
          "zh": "我很好，謝謝。您呢？"
        },
        {
          "who": "B",
          "en": "Pretty good. Have a good day at school.",
          "zh": "還不錯。祝你在學校有美好的一天。"
        },
        {
          "who": "A",
          "en": "Thanks. See you later!",
          "zh": "謝謝，待會見！"
        }
      ]
    }
  ],
