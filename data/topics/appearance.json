  "sentences": [
    {
      "en": "What does she look like?",
      "zh": "她長什麼樣子？",
      "note": "詢問某人外貌時"
    },
    {
      "en": "She is tall and has long hair.",
      "zh": "她很高，留著長髮。",
      "note": "描述外貌時"
    },
    {
      "en": "He is a short boy with glasses.",
      "zh": "他是個戴眼鏡的矮個子男孩。",
      "note": "描述人物特徵時"
    },
    {
      "en": "How tall are you?",
      "zh": "你有多高？",
      "note": "詢問身高時"
    },
    {
      "en": "I'm about 160 centimeters tall.",
      "zh": "我大約一百六十公分高。",
      "note": "回答身高時"
    },
    {
      "en": "You look great today.",
      "zh": "你今天看起來很棒。",
      "note": "稱讚對方時"
    },
    {
      "en": "What is he like?",
      "zh": "他是個怎樣的人？",
      "note": "詢問個性時"
    },
    {
      "en": "He is kind and funny.",
      "zh": "他親切又幽默。",
      "note": "描述個性時"
    },
    {
      "en": "She is shy but very friendly.",
      "zh": "她害羞，但很友善。",
      "note": "形容個性時"
    },
    {
      "en": "I am quiet at school but outgoing at home.",
      "zh": "我在學校很安靜，在家卻很外向。",
      "note": "介紹自己的個性時"
    },
    {
      "en": "You look just like your dad.",
      "zh": "你長得跟你爸爸一模一樣。",
      "note": "說某人像家人時"
    },
    {
      "en": "She has a good sense of humor.",
      "zh": "她很有幽默感。",
      "note": "稱讚別人的個性時"
    },
    {
      "en": "He isn't lazy at all.",
      "zh": "他一點也不懶惰。",
      "note": "否定某種個性時"
    },
    {
      "en": "My best friend is honest and smart.",
      "zh": "我最好的朋友誠實又聰明。",
      "note": "介紹好朋友時"
    },
    {
      "en": "Don't judge people by how they look.",
      "zh": "不要以貌取人。",
      "note": "提醒別人時"
    }
  ],
  "dialogues": [
    {
      "title": "找失散的朋友",
      "lines": [
        {
          "who": "A",
          "en": "Excuse me, I'm looking for my friend.",
          "zh": "不好意思，我在找我的朋友。"
        },
        {
          "who": "B",
          "en": "What does he look like?",
          "zh": "他長什麼樣子？"
        },
        {
          "who": "A",
          "en": "He is tall and thin, with curly hair and glasses.",
          "zh": "他又高又瘦，有捲髮並戴眼鏡。"
        },
        {
          "who": "B",
          "en": "I think I saw him near the gate.",
          "zh": "我想我在大門附近看過他。"
        },
        {
          "who": "A",
          "en": "Thank you so much!",
          "zh": "非常謝謝你！"
        }
      ]
    },
    {
      "title": "聊新老師",
      "lines": [
        {
          "who": "A",
          "en": "Do you like our new teacher?",
          "zh": "你喜歡我們的新老師嗎？"
        },
        {
          "who": "B",
          "en": "Yes. She is kind and very smart.",
          "zh": "喜歡，她很親切又很聰明。"
        },
        {
          "who": "A",
          "en": "I heard she is funny, too.",
          "zh": "我聽說她也很幽默。"
        },
        {
          "who": "B",
          "en": "Right. She makes the whole class laugh.",
          "zh": "沒錯，她讓全班都大笑。"
        }
      ]
    }
  ],
