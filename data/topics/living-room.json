  "sentences": [
    {
      "en": "Please have a seat.",
      "zh": "請坐。",
      "note": "招待客人時"
    },
    {
      "en": "Would you like something to drink?",
      "zh": "你想喝點什麼嗎？",
      "note": "招待客人時"
    },
    {
      "en": "Make yourself at home.",
      "zh": "請不要客氣，把這裡當自己家。",
      "note": "讓客人放輕鬆時"
    },
    {
      "en": "Can I turn on the TV?",
      "zh": "我可以開電視嗎？",
      "note": "徵求同意時"
    },
    {
      "en": "Pass me the remote control, please.",
      "zh": "請把遙控器遞給我。",
      "note": "請別人幫忙時"
    },
    {
      "en": "Could you turn down the volume?",
      "zh": "可以請你把音量調小嗎？",
      "note": "覺得太吵時"
    },
    {
      "en": "It's a little dark in here. Let me turn on the light.",
      "zh": "這裡有點暗，我來開燈。",
      "note": "房間光線不足時"
    },
    {
      "en": "I love your sofa. It's so comfortable.",
      "zh": "我好喜歡你的沙發，坐起來好舒服。",
      "note": "稱讚別人的家時"
    },
    {
      "en": "Where should I put my coat?",
      "zh": "我的外套要放哪裡？",
      "note": "到別人家作客時"
    },
    {
      "en": "Is it okay if I open the window?",
      "zh": "我可以開窗嗎？",
      "note": "想讓空氣流通時"
    },
    {
      "en": "Let's move the sofa closer to the window.",
      "zh": "我們把沙發移近窗邊吧。",
      "note": "討論家具擺放時"
    },
    {
      "en": "The living room looks great!",
      "zh": "客廳看起來好棒！",
      "note": "稱讚房間時"
    },
    {
      "en": "Could you move over a little?",
      "zh": "你可以往旁邊坐過去一點嗎？",
      "note": "想坐下但位子不夠時"
    },
    {
      "en": "Dinner will be ready in ten minutes.",
      "zh": "晚餐十分鐘後就好。",
      "note": "叫大家準備吃飯時"
    }
  ],
  "dialogues": [
    {
      "title": "招待朋友",
      "lines": [
        {
          "who": "A",
          "en": "Come in. Have a seat on the sofa.",
          "zh": "請進，坐沙發吧。"
        },
        {
          "who": "B",
          "en": "Thank you. This room is so cozy.",
          "zh": "謝謝你。這個房間好溫馨。"
        },
        {
          "who": "A",
          "en": "Would you like some tea?",
          "zh": "你想喝點茶嗎？"
        },
        {
          "who": "B",
          "en": "Yes, please. Can I put my bag here?",
          "zh": "好，麻煩你。我的包包可以放這裡嗎？"
        },
        {
          "who": "A",
          "en": "Sure. Just make yourself at home.",
          "zh": "當然，請不要客氣。"
        }
      ]
    },
    {
      "title": "搶遙控器",
      "lines": [
        {
          "who": "A",
          "en": "Where's the remote control?",
          "zh": "遙控器在哪裡？"
        },
        {
          "who": "B",
          "en": "I think it's under the cushion.",
          "zh": "我想它在靠墊下面。"
        },
        {
          "who": "A",
          "en": "Found it! Can we watch the game?",
          "zh": "找到了！我們可以看比賽嗎？"
        },
        {
          "who": "B",
          "en": "Sure. Please turn on the light first.",
          "zh": "好啊。請先開燈。"
        },
        {
          "who": "A",
          "en": "Okay. And turn down the volume a little.",
          "zh": "好的。還有音量調小一點。"
        }
      ]
    }
  ],
