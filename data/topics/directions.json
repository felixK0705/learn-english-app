  "sentences": [
    {
      "en": "Excuse me, how do I get to the station?",
      "zh": "不好意思，請問車站怎麼走？",
      "note": "向路人問路"
    },
    {
      "en": "Could you tell me where the post office is?",
      "zh": "你能告訴我郵局在哪裡嗎？",
      "note": "禮貌地問路"
    },
    {
      "en": "Is it far from here?",
      "zh": "離這裡遠嗎？",
      "note": "確認距離"
    },
    {
      "en": "Can I walk there?",
      "zh": "我可以走路到那裡嗎？",
      "note": "確認是否步行可達"
    },
    {
      "en": "Go straight for two blocks and turn left.",
      "zh": "直走兩個街區後左轉。",
      "note": "指路時"
    },
    {
      "en": "You can’t miss it.",
      "zh": "你一定找得到。",
      "note": "安慰對方不會走錯"
    },
    {
      "en": "It is on your right, next to the bank.",
      "zh": "它在你的右邊，銀行隔壁。",
      "note": "說明確切位置"
    },
    {
      "en": "I think I’m lost. Can you help me?",
      "zh": "我好像迷路了，你可以幫我嗎？",
      "note": "迷路求助時"
    },
    {
      "en": "Which way is the exit?",
      "zh": "出口往哪個方向？",
      "note": "在大型建築裡找出口"
    },
    {
      "en": "Can you show me on the map?",
      "zh": "你可以在地圖上指給我看嗎？",
      "note": "請對方用地圖說明"
    },
    {
      "en": "How long does it take on foot?",
      "zh": "走路要多久？",
      "note": "詢問步行時間"
    },
    {
      "en": "Walk past the traffic light and you will see it.",
      "zh": "走過紅綠燈就會看到了。",
      "note": "指路時"
    },
    {
      "en": "I’m looking for this address.",
      "zh": "我在找這個地址。",
      "note": "拿著地址問路"
    },
    {
      "en": "Sorry, I’m not from around here.",
      "zh": "抱歉，我不是本地人。",
      "note": "無法幫忙指路時"
    }
  ],
  "dialogues": [
    {
      "title": "問路去圖書館",
      "lines": [
        {
          "who": "A",
          "en": "Excuse me, where is the library?",
          "zh": "不好意思，圖書館在哪裡？"
        },
        {
          "who": "B",
          "en": "Go straight and turn left at the intersection.",
          "zh": "直走，在十字路口左轉。"
        },
        {
          "who": "A",
          "en": "Is it far from here?",
          "zh": "離這裡遠嗎？"
        },
        {
          "who": "B",
          "en": "No, it is only two blocks away, next to the bank.",
          "zh": "不遠，只有兩個街區，在銀行隔壁。"
        },
        {
          "who": "A",
          "en": "Thank you very much!",
          "zh": "非常感謝！"
        }
      ]
    },
    {
      "title": "迷路了",
      "lines": [
        {
          "who": "A",
          "en": "I think I’m lost. Can you help me?",
          "zh": "我好像迷路了，可以幫我嗎？"
        },
        {
          "who": "B",
          "en": "Sure. Where do you want to go?",
          "zh": "當然，你想去哪裡？"
        },
        {
          "who": "A",
          "en": "I’m looking for this address.",
          "zh": "我在找這個地址。"
        },
        {
          "who": "B",
          "en": "It is around the corner, across from the cinema.",
          "zh": "就在轉角，電影院對面。"
        },
        {
          "who": "A",
          "en": "Great, I see it now. Thanks!",
          "zh": "太好了，我看到了，謝謝！"
        }
      ]
    }
  ]
}
