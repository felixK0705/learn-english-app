  "sentences": [
    {
      "en": "How are you feeling today?",
      "zh": "你今天感覺如何？",
      "note": "關心對方心情時"
    },
    {
      "en": "I am so happy to see you.",
      "zh": "見到你我好開心。",
      "note": "表達開心時"
    },
    {
      "en": "Why are you sad?",
      "zh": "你為什麼難過？",
      "note": "關心難過的人時"
    },
    {
      "en": "I feel a little nervous.",
      "zh": "我覺得有點緊張。",
      "note": "說明自己緊張時"
    },
    {
      "en": "Do not be afraid.",
      "zh": "別害怕。",
      "note": "安慰對方時"
    },
    {
      "en": "Cheer up! It will be okay.",
      "zh": "打起精神！會沒事的。",
      "note": "鼓勵心情低落的人時"
    },
    {
      "en": "I am tired and I want to sleep.",
      "zh": "我累了，想睡覺。",
      "note": "表達疲倦時"
    },
    {
      "en": "I am very proud of you.",
      "zh": "我真為你感到驕傲。",
      "note": "稱讚對方時"
    },
    {
      "en": "That makes me angry.",
      "zh": "那讓我很生氣。",
      "note": "表達不滿時"
    },
    {
      "en": "I am sorry you feel that way.",
      "zh": "聽到你這麼覺得我很難過。",
      "note": "表達同情時"
    },
    {
      "en": "What a nice surprise!",
      "zh": "真是個驚喜！",
      "note": "收到意外的驚喜時"
    },
    {
      "en": "I am bored. Let us do something fun.",
      "zh": "我好無聊，我們找點好玩的事做吧。",
      "note": "覺得無聊時"
    },
    {
      "en": "Calm down and tell me what happened.",
      "zh": "冷靜下來，告訴我發生什麼事。",
      "note": "對方情緒激動時"
    },
    {
      "en": "I feel much better now.",
      "zh": "我現在好多了。",
      "note": "心情或身體好轉時"
    },
    {
      "en": "Thank you. I am really grateful.",
      "zh": "謝謝你，我真的很感激。",
      "note": "表達感謝時"
    }
  ],
  "dialogues": [
    {
      "title": "安慰朋友",
      "lines": [
        {
          "who": "A",
          "en": "You look sad. What is wrong?",
          "zh": "你看起來很難過，怎麼了？"
        },
        {
          "who": "B",
          "en": "I failed my math test.",
          "zh": "我數學考試不及格。"
        },
        {
          "who": "A",
          "en": "Cheer up! You can try again next time.",
          "zh": "打起精神！下次再試一次。"
        },
        {
          "who": "B",
          "en": "Thanks. I feel a little better now.",
          "zh": "謝謝，我現在好多了。"
        }
      ]
    },
    {
      "title": "考試前",
      "lines": [
        {
          "who": "A",
          "en": "I am so nervous about the speech.",
          "zh": "我對演講好緊張。"
        },
        {
          "who": "B",
          "en": "Take a deep breath and calm down.",
          "zh": "深呼吸，冷靜下來。"
        },
        {
          "who": "A",
          "en": "I have butterflies in my stomach.",
          "zh": "我緊張得七上八下。"
        },
        {
          "who": "B",
          "en": "You practiced a lot. I am sure you will do well.",
          "zh": "你練習很多次了，我相信你會表現得很好。"
        },
        {
          "who": "A",
          "en": "Thank you for cheering me on.",
          "zh": "謝謝你幫我加油。"
        }
      ]
    }
  ]
}