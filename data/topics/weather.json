  "sentences": [
    {
      "en": "How's the weather today?",
      "zh": "今天天氣怎麼樣？",
      "note": "日常問候"
    },
    {
      "en": "It's sunny and warm.",
      "zh": "天氣晴朗又暖和。",
      "note": "回答天氣"
    },
    {
      "en": "It looks like it's going to rain.",
      "zh": "看起來快要下雨了。",
      "note": "天色變暗時"
    },
    {
      "en": "Take an umbrella just in case.",
      "zh": "帶把傘以防萬一。",
      "note": "出門前提醒"
    },
    {
      "en": "What's the weather forecast for tomorrow?",
      "zh": "明天的天氣預報怎麼說？",
      "note": "計畫行程"
    },
    {
      "en": "It's pouring outside!",
      "zh": "外面下傾盆大雨！",
      "note": "形容大雨"
    },
    {
      "en": "It's freezing today.",
      "zh": "今天冷死了。",
      "note": "覺得非常冷"
    },
    {
      "en": "It's so hot and humid.",
      "zh": "天氣又熱又悶。",
      "note": "抱怨天氣"
    },
    {
      "en": "The typhoon is getting closer.",
      "zh": "颱風越來越近了。",
      "note": "颱風消息"
    },
    {
      "en": "Look at that rainbow!",
      "zh": "看那道彩虹！",
      "note": "看到彩虹時"
    },
    {
      "en": "Wear a jacket. It's chilly.",
      "zh": "穿件外套，有點涼。",
      "note": "提醒穿衣"
    },
    {
      "en": "What's your favorite season?",
      "zh": "你最喜歡哪個季節？",
      "note": "聊季節喜好"
    },
    {
      "en": "I love autumn because it's cool.",
      "zh": "我喜歡秋天，因為很涼爽。",
      "note": "說明理由"
    },
    {
      "en": "It might snow this weekend.",
      "zh": "這個週末可能會下雪。",
      "note": "預測天氣"
    },
    {
      "en": "The temperature dropped to ten degrees.",
      "zh": "氣溫降到了十度。",
      "note": "描述降溫"
    }
  ],
  "dialogues": [
    {
      "title": "出門前",
      "lines": [
        {
          "who": "A",
          "en": "What's the weather like?",
          "zh": "外面天氣怎麼樣？"
        },
        {
          "who": "B",
          "en": "It's cloudy, and it might rain.",
          "zh": "多雲，而且可能會下雨。"
        },
        {
          "who": "A",
          "en": "Should I take an umbrella?",
          "zh": "我要帶傘嗎？"
        },
        {
          "who": "B",
          "en": "Yes, and wear a jacket. It's chilly.",
          "zh": "要，還要穿外套，有點涼。"
        }
      ]
    },
    {
      "title": "聊季節",
      "lines": [
        {
          "who": "A",
          "en": "Which season do you like best?",
          "zh": "你最喜歡哪個季節？"
        },
        {
          "who": "B",
          "en": "I like winter because I love snow.",
          "zh": "我喜歡冬天，因為我愛雪。"
        },
        {
          "who": "A",
          "en": "But it's so cold!",
          "zh": "可是好冷喔！"
        },
        {
          "who": "B",
          "en": "I don't mind. I just wear a warm scarf.",
          "zh": "我不在意，只要戴條暖暖的圍巾。"
        },
        {
          "who": "A",
          "en": "I prefer spring. It's warm and the flowers are beautiful.",
          "zh": "我比較喜歡春天，既溫暖花又漂亮。"
        }
      ]
    }
  ],
