  "sentences": [
    {
      "en": "What sport do you like?",
      "zh": "你喜歡什麼運動？",
      "note": "聊運動話題"
    },
    {
      "en": "Do you want to play basketball with us?",
      "zh": "你想和我們一起打籃球嗎？",
      "note": "邀請別人加入"
    },
    {
      "en": "Pass the ball to me!",
      "zh": "把球傳給我！",
      "note": "比賽中要球"
    },
    {
      "en": "Good job! Nice shot!",
      "zh": "做得好！好球！",
      "note": "稱讚隊友"
    },
    {
      "en": "Let's warm up first.",
      "zh": "我們先暖身吧。",
      "note": "運動開始前"
    },
    {
      "en": "Which team are you on?",
      "zh": "你是哪一隊的？",
      "note": "觀賽或分組時"
    },
    {
      "en": "I'm on the school swimming team.",
      "zh": "我是學校游泳隊的。",
      "note": "介紹自己的隊伍"
    },
    {
      "en": "The score is two to one.",
      "zh": "比數是二比一。",
      "note": "報告比分"
    },
    {
      "en": "We lost, but we had fun.",
      "zh": "我們輸了，但是很開心。",
      "note": "輸球後的心情"
    },
    {
      "en": "How often do you exercise?",
      "zh": "你多久運動一次？",
      "note": "詢問運動習慣"
    },
    {
      "en": "I run in the park every morning.",
      "zh": "我每天早上在公園跑步。",
      "note": "說明運動習慣"
    },
    {
      "en": "Be careful! Don't get hurt.",
      "zh": "小心！不要受傷。",
      "note": "提醒安全"
    },
    {
      "en": "Whose turn is it to serve?",
      "zh": "輪到誰發球？",
      "note": "比賽規則討論"
    },
    {
      "en": "The game starts at three o'clock.",
      "zh": "比賽三點開始。",
      "note": "通知比賽時間"
    }
  ],
  "dialogues": [
    {
      "title": "邀請打球",
      "lines": [
        {
          "who": "A",
          "en": "Do you want to play badminton after school?",
          "zh": "放學後你想打羽毛球嗎？"
        },
        {
          "who": "B",
          "en": "Sure! I'll bring my racket.",
          "zh": "好啊！我會帶我的球拍。"
        },
        {
          "who": "A",
          "en": "Let's meet at the gym at four.",
          "zh": "我們四點在體育館見。"
        },
        {
          "who": "B",
          "en": "Sounds good. See you there!",
          "zh": "聽起來不錯，到時見！"
        }
      ]
    },
    {
      "title": "比賽後",
      "lines": [
        {
          "who": "A",
          "en": "Who won the game?",
          "zh": "誰贏了比賽？"
        },
        {
          "who": "B",
          "en": "Our team won three to two.",
          "zh": "我們隊以三比二獲勝。"
        },
        {
          "who": "A",
          "en": "Congratulations! Who scored the last goal?",
          "zh": "恭喜！最後一球是誰進的？"
        },
        {
          "who": "B",
          "en": "Amy did. She was great.",
          "zh": "是艾美，她太棒了。"
        }
      ]
    }
  ]
}
