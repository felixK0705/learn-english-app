  "sentences": [
    {
      "en": "What time is it?",
      "zh": "現在幾點？",
      "note": "詢問時間"
    },
    {
      "en": "It's a quarter to eight.",
      "zh": "現在是七點四十五分。",
      "note": "回答時間"
    },
    {
      "en": "What day is it today?",
      "zh": "今天星期幾？",
      "note": "問星期"
    },
    {
      "en": "Today is Wednesday.",
      "zh": "今天是星期三。",
      "note": "回答星期"
    },
    {
      "en": "What's the date today?",
      "zh": "今天是幾月幾號？",
      "note": "問日期"
    },
    {
      "en": "It's November twenty-third.",
      "zh": "今天是十一月二十三日。",
      "note": "回答日期"
    },
    {
      "en": "When is your birthday?",
      "zh": "你的生日是什麼時候？",
      "note": "聊生日"
    },
    {
      "en": "My birthday is on March fifth.",
      "zh": "我的生日是三月五日。",
      "note": "回答生日"
    },
    {
      "en": "I'm free on Saturday afternoon.",
      "zh": "我星期六下午有空。",
      "note": "約時間"
    },
    {
      "en": "What time does the class start?",
      "zh": "課幾點開始？",
      "note": "詢問時間表"
    },
    {
      "en": "Sorry, I'm running late.",
      "zh": "抱歉，我快遲到了。",
      "note": "通知會遲到"
    },
    {
      "en": "Let's meet at half past six.",
      "zh": "我們六點半見面吧。",
      "note": "約定時間"
    },
    {
      "en": "See you next week.",
      "zh": "下週見。",
      "note": "道別"
    },
    {
      "en": "How long does it take?",
      "zh": "這要花多久？",
      "note": "問所需時間"
    },
    {
      "en": "I get up at seven every morning.",
      "zh": "我每天早上七點起床。",
      "note": "描述作息"
    }
  ],
  "dialogues": [
    {
      "title": "約時間",
      "lines": [
        {
          "who": "A",
          "en": "Are you free this weekend?",
          "zh": "你這個週末有空嗎？"
        },
        {
          "who": "B",
          "en": "I'm busy on Saturday, but free on Sunday.",
          "zh": "我星期六很忙，但星期日有空。"
        },
        {
          "who": "A",
          "en": "Great! Let's meet at ten in the morning.",
          "zh": "太好了！我們早上十點見面吧。"
        },
        {
          "who": "B",
          "en": "Okay. I'll be there on time.",
          "zh": "好，我會準時到。"
        }
      ]
    },
    {
      "title": "問時間",
      "lines": [
        {
          "who": "A",
          "en": "Excuse me, what time is it?",
          "zh": "不好意思，請問現在幾點？"
        },
        {
          "who": "B",
          "en": "It's half past four.",
          "zh": "現在四點半。"
        },
        {
          "who": "A",
          "en": "Oh no! The bus leaves at a quarter to five.",
          "zh": "糟了！公車四點四十五分開。"
        },
        {
          "who": "B",
          "en": "Hurry up. You still have fifteen minutes.",
          "zh": "快點，你還有十五分鐘。"
        }
      ]
    }
  ]
