  "sentences": [
    {
      "en": "What is that? It smells interesting.",
      "zh": "那是什麼？聞起來好特別。",
      "note": "對新食物好奇時"
    },
    {
      "en": "Can I have one, please?",
      "zh": "我可以要一份嗎？",
      "note": "點小吃時"
    },
    {
      "en": "How much is one portion?",
      "zh": "一份多少錢？",
      "note": "詢問價格時"
    },
    {
      "en": "Is it spicy?",
      "zh": "會辣嗎？",
      "note": "詢問辣度時"
    },
    {
      "en": "Not spicy, please.",
      "zh": "請不要辣。",
      "note": "不吃辣時"
    },
    {
      "en": "Could you add some extra sauce?",
      "zh": "可以多加一點醬嗎？",
      "note": "加料時"
    },
    {
      "en": "No cilantro, please.",
      "zh": "請不要加香菜。",
      "note": "不要某種配料時"
    },
    {
      "en": "Can I get it to go?",
      "zh": "可以外帶嗎？",
      "note": "想帶走時"
    },
    {
      "en": "The line is so long!",
      "zh": "隊伍好長喔！",
      "note": "抱怨排隊時"
    },
    {
      "en": "Is this stall famous?",
      "zh": "這攤很有名嗎？",
      "note": "詢問人氣時"
    },
    {
      "en": "Let us share this one.",
      "zh": "我們一起分這個吧。",
      "note": "想分食時"
    },
    {
      "en": "Do you take mobile payments?",
      "zh": "你們可以行動支付嗎？",
      "note": "結帳時"
    },
    {
      "en": "I have never tried this before.",
      "zh": "我從來沒吃過這個。",
      "note": "嘗試新東西時"
    },
    {
      "en": "That was delicious. Thank you!",
      "zh": "好好吃，謝謝！",
      "note": "向老闆道謝時"
    }
  ],
  "dialogues": [
    {
      "title": "點一份蚵仔煎",
      "lines": [
        {
          "who": "A",
          "en": "Hi! I would like one oyster omelet.",
          "zh": "你好！我要一份蚵仔煎。"
        },
        {
          "who": "B",
          "en": "Sure. Do you want it spicy?",
          "zh": "好的，要加辣嗎？"
        },
        {
          "who": "A",
          "en": "No, thanks. And no cilantro, please.",
          "zh": "不用，謝謝，也請不要加香菜。"
        },
        {
          "who": "B",
          "en": "Okay. It will take five minutes.",
          "zh": "好，要等五分鐘。"
        },
        {
          "who": "A",
          "en": "No problem. How much is it?",
          "zh": "沒問題，多少錢？"
        }
      ]
    },
    {
      "title": "和朋友逛夜市",
      "lines": [
        {
          "who": "A",
          "en": "Look at that line! What are they selling?",
          "zh": "你看那條隊伍！他們在賣什麼？"
        },
        {
          "who": "B",
          "en": "Fried chicken cutlet. It is really famous.",
          "zh": "炸雞排，很有名的。"
        },
        {
          "who": "A",
          "en": "Let us stand in line and try it.",
          "zh": "我們去排隊試試吧。"
        },
        {
          "who": "B",
          "en": "Good idea. I am so hungry.",
          "zh": "好主意，我好餓。"
        }
      ]
    }
  ]
}
