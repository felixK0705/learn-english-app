  "sentences": [
    {
      "en": "This is a photo of my family.",
      "zh": "這是我的全家福照片。",
      "note": "介紹家人照片時"
    },
    {
      "en": "There are five people in my family.",
      "zh": "我家有五個人。",
      "note": "說明家裡人數時"
    },
    {
      "en": "Do you have any brothers or sisters?",
      "zh": "你有兄弟姊妹嗎？",
      "note": "詢問對方的家人時"
    },
    {
      "en": "I have one older brother.",
      "zh": "我有一個哥哥。",
      "note": "說明自己的兄弟姊妹時"
    },
    {
      "en": "I am an only child.",
      "zh": "我是獨生子（女）。",
      "note": "說明自己沒有兄弟姊妹時"
    },
    {
      "en": "Who is that woman in the picture?",
      "zh": "照片裡的那位女士是誰？",
      "note": "詢問照片中的人時"
    },
    {
      "en": "She is my aunt.",
      "zh": "她是我的阿姨。",
      "note": "回答對方對親戚的詢問時"
    },
    {
      "en": "My parents both work.",
      "zh": "我的父母都有工作。",
      "note": "談到父母時"
    },
    {
      "en": "I live with my grandparents.",
      "zh": "我和祖父母同住。",
      "note": "說明與誰同住時"
    },
    {
      "en": "We have dinner together every night.",
      "zh": "我們每天晚上一起吃晚餐。",
      "note": "描述家庭習慣時"
    },
    {
      "en": "My mom is a very kind person.",
      "zh": "我媽媽是一個很親切的人。",
      "note": "稱讚家人時"
    },
    {
      "en": "I look like my father.",
      "zh": "我長得像我爸爸。",
      "note": "談論外貌像誰時"
    },
    {
      "en": "How is your family?",
      "zh": "你的家人好嗎？",
      "note": "關心對方家人時"
    },
    {
      "en": "My family is going to visit my uncle.",
      "zh": "我們全家要去探望我叔叔。",
      "note": "談論家庭計畫時"
    },
    {
      "en": "I love my family.",
      "zh": "我愛我的家人。",
      "note": "表達對家人的感情時"
    }
  ],
  "dialogues": [
    {
      "title": "看家庭照片",
      "lines": [
        {
          "who": "A",
          "en": "Who is this?",
          "zh": "這是誰？"
        },
        {
          "who": "B",
          "en": "She is my aunt. She lives in Tainan.",
          "zh": "她是我的阿姨，住在台南。"
        },
        {
          "who": "A",
          "en": "And who is the boy next to her?",
          "zh": "那她旁邊的男孩是誰？"
        },
        {
          "who": "B",
          "en": "That's my cousin, Jack.",
          "zh": "那是我的表哥傑克。"
        },
        {
          "who": "A",
          "en": "You have a big family!",
          "zh": "你的家人真多！"
        }
      ]
    },
    {
      "title": "聊兄弟姊妹",
      "lines": [
        {
          "who": "A",
          "en": "Do you have any brothers or sisters?",
          "zh": "你有兄弟姊妹嗎？"
        },
        {
          "who": "B",
          "en": "Yes, I have a little sister. How about you?",
          "zh": "有，我有一個妹妹。你呢？"
        },
        {
          "who": "A",
          "en": "I'm an only child.",
          "zh": "我是獨生子。"
        },
        {
          "who": "B",
          "en": "Do you feel lonely sometimes?",
          "zh": "你有時候會覺得孤單嗎？"
        },
        {
          "who": "A",
          "en": "A little, but I like playing with my cousins.",
          "zh": "有一點，不過我喜歡跟表兄弟姊妹玩。"
        }
      ]
    }
  ]
}