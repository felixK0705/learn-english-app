  "sentences": [
    {
      "en": "What instrument do you play?",
      "zh": "你演奏什麼樂器？",
      "note": "認識新朋友時"
    },
    {
      "en": "I have played the piano for five years.",
      "zh": "我彈鋼琴已經五年了。",
      "note": "介紹自己的音樂經歷"
    },
    {
      "en": "Please play a little softer.",
      "zh": "請演奏得小聲一點。",
      "note": "指導合奏時"
    },
    {
      "en": "Let us try that part again.",
      "zh": "我們再練習一次那一段。",
      "note": "排練時"
    },
    {
      "en": "You are out of tune.",
      "zh": "你音不準了。",
      "note": "提醒同學調音"
    },
    {
      "en": "Can you play this song for me?",
      "zh": "你可以為我演奏這首歌嗎？",
      "note": "請朋友表演"
    },
    {
      "en": "Count to four and start together.",
      "zh": "數到四然後一起開始。",
      "note": "合奏開始前"
    },
    {
      "en": "Hold the recorder like this.",
      "zh": "直笛要像這樣握。",
      "note": "教同學吹直笛"
    },
    {
      "en": "The concert starts at seven thirty.",
      "zh": "音樂會七點半開始。",
      "note": "通知演出時間"
    },
    {
      "en": "I am nervous about the solo.",
      "zh": "我對獨奏感到緊張。",
      "note": "表達上台前心情"
    },
    {
      "en": "That was a wonderful performance!",
      "zh": "那場演出太精彩了！",
      "note": "稱讚表演"
    },
    {
      "en": "Which song should we sing next?",
      "zh": "我們下一首要唱什麼歌？",
      "note": "討論曲目"
    },
    {
      "en": "Please put your instrument back in its case.",
      "zh": "請把你的樂器放回琴盒。",
      "note": "下課收拾時"
    },
    {
      "en": "I would like to learn the guitar.",
      "zh": "我想學吉他。",
      "note": "表達學習意願"
    }
  ],
  "dialogues": [
    {
      "title": "選擇樂器",
      "lines": [
        {
          "who": "A",
          "en": "Which instrument do you want to try?",
          "zh": "你想試哪一種樂器？"
        },
        {
          "who": "B",
          "en": "I would like to play the trumpet.",
          "zh": "我想吹小號。"
        },
        {
          "who": "A",
          "en": "It is loud, but it is a lot of fun.",
          "zh": "它很大聲，但很好玩。"
        },
        {
          "who": "B",
          "en": "Great. Let me show you how to hold it.",
          "zh": "好，我來教你怎麼拿。"
        }
      ]
    },
    {
      "title": "合唱團練習",
      "lines": [
        {
          "who": "A",
          "en": "Are you ready to sing?",
          "zh": "你準備好要唱了嗎？"
        },
        {
          "who": "B",
          "en": "Yes, but the high notes are hard.",
          "zh": "是的，但是高音很難。"
        },
        {
          "who": "A",
          "en": "Take a deep breath and relax.",
          "zh": "深呼吸，放輕鬆。"
        },
        {
          "who": "B",
          "en": "Okay. Let us try again.",
          "zh": "好，我們再試一次。"
        }
      ]
    }
  ]
}
