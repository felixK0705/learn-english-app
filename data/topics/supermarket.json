  "sentences": [
    {
      "en": "Where can I find the milk?",
      "zh": "牛奶在哪裡可以找到？",
      "note": "在超市找商品"
    },
    {
      "en": "How much is this?",
      "zh": "這個多少錢？",
      "note": "詢問價格"
    },
    {
      "en": "Do you have this in a larger size?",
      "zh": "這個有大一點的嗎？",
      "note": "找不同容量或尺寸"
    },
    {
      "en": "Is this on sale?",
      "zh": "這個有特價嗎？",
      "note": "詢問是否打折"
    },
    {
      "en": "I’d like a bag, please.",
      "zh": "請給我一個袋子。",
      "note": "結帳時要袋子"
    },
    {
      "en": "Do you need a bag?",
      "zh": "你需要袋子嗎？",
      "note": "店員詢問顧客"
    },
    {
      "en": "Can you heat this up for me?",
      "zh": "可以幫我加熱這個嗎？",
      "note": "在便利商店買熱食"
    },
    {
      "en": "Do you accept credit cards?",
      "zh": "你們可以刷卡嗎？",
      "note": "確認付款方式"
    },
    {
      "en": "Can I have the receipt, please?",
      "zh": "可以給我收據嗎？",
      "note": "結帳後索取發票"
    },
    {
      "en": "Can I get a refund for this?",
      "zh": "這個可以退費嗎？",
      "note": "要求退貨或退款"
    },
    {
      "en": "Do you have a membership card?",
      "zh": "你有會員卡嗎？",
      "note": "店員詢問會員"
    },
    {
      "en": "Please check the expiration date.",
      "zh": "請檢查有效期限。",
      "note": "挑選食品時提醒"
    },
    {
      "en": "Excuse me, where is the checkout?",
      "zh": "不好意思，結帳櫃台在哪裡？",
      "note": "找結帳處"
    },
    {
      "en": "Can I pick up and pay for my package here?",
      "zh": "我可以在這裡取貨付款嗎？",
      "note": "在便利商店取包裹時"
    }
  ],
  "dialogues": [
    {
      "title": "在超市找東西",
      "lines": [
        {
          "who": "A",
          "en": "Excuse me, where can I find yogurt?",
          "zh": "不好意思，請問優格在哪裡？"
        },
        {
          "who": "B",
          "en": "It's in aisle three, next to the cheese.",
          "zh": "在第三走道，起司旁邊。"
        },
        {
          "who": "A",
          "en": "Thank you. Is it on sale today?",
          "zh": "謝謝，今天有特價嗎？"
        },
        {
          "who": "B",
          "en": "Yes, it's buy one get one free.",
          "zh": "有，買一送一。"
        },
        {
          "who": "A",
          "en": "Great, I'll take two.",
          "zh": "太好了，我要兩個。"
        }
      ]
    },
    {
      "title": "在便利商店結帳",
      "lines": [
        {
          "who": "A",
          "en": "Hello. That'll be one hundred and ten dollars.",
          "zh": "你好，總共一百一十元。"
        },
        {
          "who": "B",
          "en": "Can you heat up this lunch box?",
          "zh": "可以幫我加熱這個便當嗎？"
        },
        {
          "who": "A",
          "en": "Sure. Do you need a bag?",
          "zh": "好的，你需要袋子嗎？"
        },
        {
          "who": "B",
          "en": "No, thanks. I have my own bag.",
          "zh": "不用，謝謝，我有自己的袋子。"
        },
        {
          "who": "A",
          "en": "Here is your receipt.",
          "zh": "這是你的發票。"
        }
      ]
    }
  ],
