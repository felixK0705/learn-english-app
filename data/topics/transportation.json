  "sentences": [
    {
      "en": "How do I get to the station?",
      "zh": "我要怎麼去車站？",
      "note": "詢問交通方式"
    },
    {
      "en": "Which bus goes to the night market?",
      "zh": "哪一班公車會到夜市？",
      "note": "在公車站詢問路線"
    },
    {
      "en": "How much is the fare?",
      "zh": "車資是多少？",
      "note": "詢問票價"
    },
    {
      "en": "Where can I buy a ticket?",
      "zh": "我可以在哪裡買票？",
      "note": "找售票處或售票機"
    },
    {
      "en": "Does this train stop at Taichung?",
      "zh": "這班火車有停台中嗎？",
      "note": "確認停靠站"
    },
    {
      "en": "Is this seat taken?",
      "zh": "這個位子有人坐嗎？",
      "note": "想坐在別人旁邊時"
    },
    {
      "en": "Excuse me, I’m getting off here.",
      "zh": "不好意思，我要在這裡下車。",
      "note": "在擁擠車廂請人讓路"
    },
    {
      "en": "Please take me to the airport.",
      "zh": "請載我到機場。",
      "note": "對計程車司機說"
    },
    {
      "en": "I need to top up my EasyCard.",
      "zh": "我需要儲值悠遊卡。",
      "note": "在便利商店或捷運站加值"
    },
    {
      "en": "How long does it take to get there?",
      "zh": "到那裡要多久？",
      "note": "詢問所需時間"
    },
    {
      "en": "The next train leaves at nine thirty.",
      "zh": "下一班火車九點半出發。",
      "note": "告知發車時間"
    },
    {
      "en": "Please offer your seat to people who need it.",
      "zh": "請把座位讓給需要的人。",
      "note": "提醒禮讓博愛座"
    },
    {
      "en": "We’re stuck in traffic.",
      "zh": "我們塞在車陣中。",
      "note": "告訴朋友會遲到"
    },
    {
      "en": "Can you drop me off at the next corner?",
      "zh": "你可以在下個轉角讓我下車嗎？",
      "note": "請司機或朋友停車"
    }
  ],
  "dialogues": [
    {
      "title": "在捷運站",
      "lines": [
        {
          "who": "A",
          "en": "Excuse me, how do I get to Taipei 101?",
          "zh": "不好意思，我要怎麼去台北101？"
        },
        {
          "who": "B",
          "en": "Take the red line and change trains at Daan.",
          "zh": "搭紅線，在大安站換車。"
        },
        {
          "who": "A",
          "en": "How long does it take?",
          "zh": "要多久？"
        },
        {
          "who": "B",
          "en": "About twenty minutes.",
          "zh": "大約二十分鐘。"
        },
        {
          "who": "A",
          "en": "Thanks! Do I need a ticket?",
          "zh": "謝謝！我需要買票嗎？"
        },
        {
          "who": "B",
          "en": "You can use an EasyCard.",
          "zh": "你可以用悠遊卡。"
        }
      ]
    },
    {
      "title": "搭計程車",
      "lines": [
        {
          "who": "A",
          "en": "Where to, ma’am?",
          "zh": "女士，請問去哪裡？"
        },
        {
          "who": "B",
          "en": "Please take me to the train station.",
          "zh": "請載我到火車站。"
        },
        {
          "who": "A",
          "en": "No problem. Please fasten your seat belt.",
          "zh": "沒問題，請繫好安全帶。"
        },
        {
          "who": "B",
          "en": "Is there a traffic jam today?",
          "zh": "今天會塞車嗎？"
        },
        {
          "who": "A",
          "en": "A little, but we’ll be there in fifteen minutes.",
          "zh": "有一點，不過十五分鐘就會到。"
        }
      ]
    }
  ],
