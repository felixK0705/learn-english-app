  "sentences": [
    {
      "en": "Happy birthday!",
      "zh": "生日快樂！",
      "note": "見到壽星時"
    },
    {
      "en": "How old are you now?",
      "zh": "你現在幾歲了？",
      "note": "詢問年齡"
    },
    {
      "en": "I'm turning ten today.",
      "zh": "我今天滿十歲了。",
      "note": "壽星回答時"
    },
    {
      "en": "Thank you for inviting me.",
      "zh": "謝謝你邀請我。",
      "note": "到達派對時"
    },
    {
      "en": "This gift is for you.",
      "zh": "這份禮物送給你。",
      "note": "遞上禮物時"
    },
    {
      "en": "I hope you like it.",
      "zh": "希望你會喜歡。",
      "note": "送禮時"
    },
    {
      "en": "Wow, I love it! Thank you so much.",
      "zh": "哇，我好喜歡！非常謝謝你。",
      "note": "收到禮物時"
    },
    {
      "en": "Make a wish and blow out the candles!",
      "zh": "許個願然後吹蠟燭吧！",
      "note": "切蛋糕前"
    },
    {
      "en": "Would you like a piece of cake?",
      "zh": "你想吃一塊蛋糕嗎？",
      "note": "招待客人時"
    },
    {
      "en": "Help yourself to some snacks.",
      "zh": "請自己拿點心吃。",
      "note": "招待客人時"
    },
    {
      "en": "Let's play a game!",
      "zh": "我們來玩遊戲吧！",
      "note": "派對活動時"
    },
    {
      "en": "Can we take a group photo?",
      "zh": "我們可以拍張大合照嗎？",
      "note": "派對尾聲"
    },
    {
      "en": "I had a great time. Thanks for everything!",
      "zh": "我玩得很開心，謝謝你的招待！",
      "note": "離開派對時"
    },
    {
      "en": "Have a wonderful birthday!",
      "zh": "祝你有個美好的生日！",
      "note": "祝福壽星時"
    }
  ],
  "dialogues": [
    {
      "title": "收到禮物",
      "lines": [
        {
          "who": "A",
          "en": "Happy birthday, Lily! This is for you.",
          "zh": "生日快樂，莉莉！這是給你的。"
        },
        {
          "who": "B",
          "en": "Thank you! May I open it now?",
          "zh": "謝謝！我現在可以拆開嗎？"
        },
        {
          "who": "A",
          "en": "Of course. I hope you like it.",
          "zh": "當然，希望你會喜歡。"
        },
        {
          "who": "B",
          "en": "It's a book about dinosaurs. I love it!",
          "zh": "是一本恐龍的書，我好喜歡！"
        }
      ]
    },
    {
      "title": "吹蠟燭",
      "lines": [
        {
          "who": "A",
          "en": "Now it's time for the cake!",
          "zh": "現在是吃蛋糕的時間了！"
        },
        {
          "who": "B",
          "en": "Everyone, sing Happy Birthday!",
          "zh": "大家一起唱生日快樂歌！"
        },
        {
          "who": "A",
          "en": "Make a wish, Ben.",
          "zh": "許個願吧，班。"
        },
        {
          "who": "B",
          "en": "Okay. One, two, three!",
          "zh": "好，一、二、三！"
        }
      ]
    }
  ],
