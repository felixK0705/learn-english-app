      "title": "買雞蛋",
      "lines": [
        {
          "who": "A",
          "en": "How much are the eggs?",
          "zh": "雞蛋多少錢？"
        },
        {
          "who": "B",
          "en": "A dozen is sixty dollars.",
          "zh": "一打六十元。"
        },
        {
          "who": "A",
          "en": "I'd like two dozen, please.",
          "zh": "我要兩打，麻煩你。"
        },
        {
          "who": "B",
          "en": "That'll be one hundred and twenty dollars.",
          "zh": "一共是一百二十元。"
        }
      ]
    },
    {
      "title": "分披薩",
