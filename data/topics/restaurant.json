  "sentences": [
    {
      "en": "Hi, I have a reservation under Lin.",
      "zh": "你好，我以林的名字訂了位。",
      "note": "報上訂位時"
    },
    {
      "en": "A table for four, please.",
      "zh": "請給我四人桌。",
      "note": "沒有訂位入座時"
    },
    {
      "en": "Could we sit by the window?",
      "zh": "我們可以坐靠窗的位子嗎？",
      "note": "想選位子時"
    },
    {
      "en": "Can I see the menu, please?",
      "zh": "我可以看一下菜單嗎？",
      "note": "需要菜單時"
    },
    {
      "en": "What do you recommend?",
      "zh": "你推薦什麼？",
      "note": "不知道點什麼時"
    },
    {
      "en": "I'll have the chicken pasta.",
      "zh": "我要點雞肉義大利麵。",
      "note": "決定餐點時"
    },
    {
      "en": "Does this dish come with a drink?",
      "zh": "這道菜有附飲料嗎？",
      "note": "詢問套餐內容時"
    },
    {
      "en": "Is this dish spicy?",
      "zh": "這道菜會辣嗎？",
      "note": "詢問辣度時"
    },
    {
      "en": "I'm allergic to nuts. Are there any nuts in it?",
      "zh": "我對堅果過敏，裡面有堅果嗎？",
      "note": "說明過敏時"
    },
    {
      "en": "Could I get some more water, please?",
      "zh": "可以再給我一些水嗎？",
      "note": "需要加水時"
    },
    {
      "en": "Excuse me, I didn't order this.",
      "zh": "不好意思，我沒有點這個。",
      "note": "上錯菜時"
    },
    {
      "en": "Could we get the bill, please?",
      "zh": "請幫我們結帳。",
      "note": "準備離開時"
    },
    {
      "en": "Is service included?",
      "zh": "有含服務費嗎？",
      "note": "結帳時"
    },
    {
      "en": "Can we pay separately?",
      "zh": "我們可以分開付嗎？",
      "note": "朋友各付各的時"
    },
    {
      "en": "Could you box this up for me?",
      "zh": "可以幫我打包嗎？",
      "note": "吃不完要帶走時"
    }
  ],
  "dialogues": [
    {
      "title": "訂位與入座",
      "lines": [
        {
          "who": "A",
          "en": "Good evening. Do you have a reservation?",
          "zh": "晚安，請問有訂位嗎？"
        },
        {
          "who": "B",
          "en": "Yes, a table for four under Chen.",
          "zh": "有，以陳的名字訂了四人桌。"
        },
        {
          "who": "A",
          "en": "Right this way, please.",
          "zh": "這邊請。"
        },
        {
          "who": "B",
          "en": "Thank you. Can we see the menu?",
          "zh": "謝謝，我們可以看菜單嗎？"
        },
        {
          "who": "A",
          "en": "Of course. I'll be right back.",
          "zh": "當然，我馬上回來。"
        }
      ]
    },
    {
      "title": "點餐與結帳",
      "lines": [
        {
          "who": "A",
          "en": "Are you ready to order?",
          "zh": "你們準備好點餐了嗎？"
        },
        {
          "who": "B",
          "en": "I'll have the steak, medium rare, and a salad.",
          "zh": "我要牛排三分熟，還有一份沙拉。"
        },
        {
          "who": "A",
          "en": "Anything to drink?",
          "zh": "要喝什麼嗎？"
        },
        {
          "who": "B",
          "en": "Just water, please.",
          "zh": "只要水就好，謝謝。"
        },
        {
          "who": "A",
          "en": "Here's your bill. Did you enjoy your meal?",
          "zh": "這是您的帳單。餐點還滿意嗎？"
        },
        {
          "who": "B",
          "en": "Yes, it was delicious. Can I pay by credit card?",
          "zh": "很滿意，很好吃。我可以刷信用卡嗎？"
        },
        {
          "who": "A",
          "en": "Of course.",
          "zh": "當然可以。"
        }
      ]
    }
  ],
