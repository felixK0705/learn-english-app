  "sentences": [
    {
      "en": "Excuse me, may I come in?",
      "zh": "不好意思，我可以進來嗎？",
      "note": "進入房間或教室前"
    },
    {
      "en": "Thank you very much.",
      "zh": "非常謝謝你。",
      "note": "表達感謝時"
    },
    {
      "en": "You are welcome.",
      "zh": "不客氣。",
      "note": "回應別人的感謝時"
    },
    {
      "en": "I am sorry for being late.",
      "zh": "我為遲到道歉。",
      "note": "遲到時"
    },
    {
      "en": "That is all right. Do not worry.",
      "zh": "沒關係，別擔心。",
      "note": "回應道歉時"
    },
    {
