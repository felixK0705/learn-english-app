  "dialogues": [
    {
      "title": "在公車上",
      "lines": [
        {
          "who": "A",
          "en": "Excuse me, is this seat taken?",
          "zh": "不好意思，這個位子有人坐嗎？"
        },
        {
          "who": "B",
          "en": "No, go ahead.",
          "zh": "沒有，請坐。"
        },
        {
          "who": "A",
          "en": "Thank you very much.",
          "zh": "非常謝謝你。"
        },
        {
          "who": "B",
          "en": "You are welcome.",
          "zh": "不客氣。"
        }
      ]
    },
    {
      "title": "拜訪朋友家",
      "lines": [
        {
          "who": "A",
          "en": "Come in and make yourself at home.",
          "zh": "請進，把這裡當自己家。"
        },
        {
          "who": "B",
          "en": "Thank you for inviting me.",
          "zh": "謝謝你邀請我。"
        },
        {
          "who": "A",
          "en": "Would you like some tea?",
          "zh": "你想喝點茶嗎？"
        },
        {
          "who": "B",
          "en": "Yes, please. That sounds good.",
          "zh": "好的，麻煩你，聽起來不錯。"
        },
        {
          "who": "A",
          "en": "Here you are. Take your time.",
          "zh": "請用，慢慢來。"
        }
      ]
    }
  ]
