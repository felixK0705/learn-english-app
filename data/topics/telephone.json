  "sentences": [
    {
      "en": "Hello, this is Tom speaking.",
      "zh": "喂，我是湯姆。",
      "note": "接電話並報上名字時"
    },
    {
      "en": "May I speak to Amy, please?",
      "zh": "請問艾咪在嗎？",
      "note": "打電話找人時"
    },
    {
      "en": "Who is calling, please?",
      "zh": "請問是哪一位？",
      "note": "詢問來電者時"
    },
    {
      "en": "Hold on a moment, please.",
      "zh": "請稍等一下。",
      "note": "請對方等候時"
    },
    {
      "en": "She isn't here right now.",
      "zh": "她現在不在。",
      "note": "說明對方不在時"
    },
    {
      "en": "Can I take a message?",
      "zh": "需要我幫你留言嗎？",
      "note": "幫忙轉達訊息時"
    },
    {
      "en": "Please tell her to call me back.",
      "zh": "請告訴她回電給我。",
      "note": "請對方回電時"
    },
    {
      "en": "I think you have the wrong number.",
      "zh": "我想你打錯電話了。",
      "note": "對方打錯電話時"
    },
    {
      "en": "I'm sorry, I can't hear you very well.",
      "zh": "抱歉，我聽不太清楚。",
      "note": "訊號不好時"
    },
    {
      "en": "Could you speak more slowly?",
      "zh": "可以請你說慢一點嗎？",
      "note": "聽不懂或聽不清楚時"
    },
    {
      "en": "I'll text you the address.",
      "zh": "我會把地址傳給你。",
      "note": "答應傳訊息時"
    },
    {
      "en": "What's your phone number?",
      "zh": "你的電話號碼是多少？",
      "note": "詢問聯絡方式時"
    },
    {
      "en": "My battery is dead. Do you have a charger?",
      "zh": "我的手機沒電了，你有充電器嗎？",
      "note": "請求借充電器時"
    },
    {
      "en": "Let's have a video call tonight.",
      "zh": "我們今晚來視訊吧。",
      "note": "約時間視訊時"
    },
    {
      "en": "I have to go now. Talk to you later.",
      "zh": "我得走了，晚點再聊。",
      "note": "結束通話時"
    }
  ],
  "dialogues": [
    {
      "title": "打電話找朋友",
      "lines": [
        {
          "who": "A",
          "en": "Hello?",
          "zh": "喂？"
        },
        {
          "who": "B",
          "en": "Hello, may I speak to Amy, please?",
          "zh": "喂，請問艾咪在嗎？"
        },
        {
          "who": "A",
          "en": "Speaking. Is that you, Tom?",
          "zh": "我就是。是湯姆嗎？"
        },
        {
          "who": "B",
          "en": "Yes. Are you free tomorrow afternoon?",
          "zh": "是的。你明天下午有空嗎？"
        },
        {
          "who": "A",
          "en": "Yes. Let me text you the details.",
          "zh": "有，我再把細節傳給你。"
        }
      ]
    },
    {
      "title": "手機沒電",
      "lines": [
        {
          "who": "A",
          "en": "My phone is dead. Do you have a charger?",
          "zh": "我的手機沒電了，你有充電器嗎？"
        },
        {
          "who": "B",
          "en": "Yes, here you are.",
          "zh": "有，給你。"
        },
        {
          "who": "A",
          "en": "Thanks. I need to call my mom.",
          "zh": "謝謝，我得打電話給我媽。"
        },
        {
          "who": "B",
          "en": "Use my phone if you want.",
          "zh": "你要的話可以用我的手機。"
        },
        {
          "who": "A",
          "en": "No, thanks. I'll just charge mine for a few minutes.",
          "zh": "不用了，謝謝，我把我的手機充幾分鐘電就好。"
        }
      ]
    }
  ],
